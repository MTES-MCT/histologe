<div id="suivi_{{ suivi.id }}" class="message-box {{ messageBoxClass }}">
	<div>
		<strong>
			{{ suivi.getCreatedByLabel(forBailleur: not forUsager, withAgentName: false) }}
			-
			{{ suivi.createdAt|date('d/m/Y') }}
		</strong>
	</div>
	{% if isUnreadMessage %}
		<span class="fr-badge fr-badge--sm fr-badge--no-icon fr-badge--warning fr-mb-1w">Nouveau message</span>
	{% endif %}
	<div class="message-box-message">
		{% set recipient = forUsager ? constant('App\\Service\\Signalement\\Suivi\\SuiviRecipient::USAGER') : constant('App\\Service\\Signalement\\Suivi\\SuiviRecipient::DEFAULT') %}
		{{ suivi.description(recipient: recipient)|replace({'___TOKEN___':csrf_token('suivi_signalement_ext_file_view')})|raw }}
	</div>
</div>