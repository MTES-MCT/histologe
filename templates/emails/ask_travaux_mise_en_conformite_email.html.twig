{% extends 'emails/base_email.html.twig' %}

{% block body %}
    <p>Bonjour,</p>
    <p>Le {{ date_cloture }}, votre dossier Signal Logement a été fermé. Les services ont signalé que les travaux de mise en conformité de votre logement étaient en cours.</p>
    <p>Cliquez sur le bouton pour nous dire où en sont les travaux dans votre logement.</p>
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" class="btn btn-primary"
           style="text-align: center">
        <tbody>
        <tr>
            <td align="left">
                <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                    <tbody>
                    <tr style="text-align: center;width: 100%">
                        <td>
                            <a href="{{ btn_link|raw }}" target="_blank" rel="noopener">Mettre à jour la situation</a></td>
                    </tr>
                    </tbody>
                </table>
            </td>
        </tr>
        </tbody>
    </table>
    <p>Si le bouton ne fonctionne pas <a href="{{ btn_link|raw }}">cliquez ici</a></p>
{% endblock %}