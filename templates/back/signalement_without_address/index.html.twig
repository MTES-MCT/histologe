{% extends 'back/base_bo.html.twig' %}

{% block title %}Signalements sans relation adresse{% endblock %}

{% block content %}
    <section class="fr-pt-4v">
        {% include 'back/breadcrumb_bo.html.twig' with {
            'level2Title': 'Outils SA',
            'level2Link': '',
            'level2Label': '',
            'level3Title': 'Signalements sans relation adresse',
            'level3Link': '',
        } %}
        <header>
            <div class="fr-grid-row">
                <div class="fr-col-12 fr-text--left">
                    <h1 class="fr-mb-0">Signalements sans relation adresse</h1>
                </div>
            </div>
        </header>
    </section>

    {{ form_start(form) }}

    <section class="fr-col-12" aria-labelledby="filters-title">
        {% include '_partials/back/filters-title.html.twig' with {
            'skiplink_href': '#list-signalements',
            'skiplink_label': 'Accéder à la liste des signalements'
        } %}
        {{ form_errors(form) }}
        <div class="fr-grid-row fr-grid-row--bottom fr-grid-row--gutters">
            <div class="fr-col-12 fr-col-lg-4">
                {{ form_row(form.territory) }}
            </div>
            <div class="fr-col-12 fr-col-lg-4">
                {{ form_row(form.statut) }}
            </div>
            <div class="fr-col-12 fr-col-lg-4">
                {{ form_row(form.isImported) }}
            </div>
            <div class="fr-col-12">
                <a href="{{ path('back_signalement_without_address_index') }}" class="fr-link fr-link--icon-left fr-icon-close-circle-line">Réinitialiser les résultats</a>
            </div>
        </div>
    </section>

    <section class="fr-col-12 fr-col-lg-3 fr-pt-0">
        {{ form_row(form.orderType) }}
    </section>

    {{ form_end(form) }}

    <div id="title-and-table-list-results">
        {% include 'back/signalement_without_address/_title-and-table-list-results.html.twig' %}
    </div>

    <dialog aria-labelledby="fr-panel-search-address-title" id="fr-panel-search-address" class="side-panel">
        <div class="side-panel__inner">
            <div class="side-panel__header">
                <button type="button" class="fr-btn--close fr-btn js-close-panel" data-panel="fr-panel-search-address" aria-controls="fr-panel-search-address" aria-expanded="false">Fermer</button>
            </div>
            <div class="side-panel__content fr-mx-3w">
                <h1 id="fr-panel-search-address-title" class="fr-panel__title">Rechercher une adresse</h1>
                <p>Signalement #<strong id="fr-panel-search-address-reference"></strong></p>
                <p>Adresse recherchée : <span id="fr-panel-search-address-adresse"></span></p>
                <div id="fr-panel-search-address-results" aria-live="polite"></div>
                <input type="hidden" id="fr-panel-search-address-token">
                <input type="hidden" id="fr-panel-search-address-link-url">
                <input type="hidden" id="fr-panel-search-address-search-params" value="{{ app.request.query.all|url_encode }}">
            </div>
            <div class="side-panel__footer">
                <div class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-lg fr-btns-group--icon-left">
                    <button class="fr-btn fr-btn--secondary fr-icon-close-line js-close-panel" type="button" data-panel="fr-panel-search-address" aria-controls="fr-panel-search-address">Annuler</button>
                </div>
            </div>
        </div>
    </dialog>

    <dialog aria-labelledby="fr-panel-infos-territory-title" id="fr-panel-infos-territory" class="side-panel">
        <div class="side-panel__inner">
            <div class="side-panel__header">
                <button type="button" class="fr-btn--close fr-btn js-close-panel" data-panel="fr-panel-infos-territory" aria-controls="fr-panel-infos-territory" aria-expanded="false">Fermer</button>
            </div>
            <div class="side-panel__content fr-mx-3w">
                <h1 id="fr-panel-infos-territory-title" class="fr-panel__title">Plus d'infos sur le territoire du signalement #<strong id="fr-panel-infos-territory-reference"></strong></h1>
                <div>
                    <ul>
                        <li><strong>Adresse actuelle du signalement :</strong> <span id="fr-panel-infos-territory-adresse"></span></li>
                        <li><strong>Territoire actuel :</strong> <span id="fr-panel-infos-territory-actual-zipAndName"></span></li>
                        <li><strong>Territoire de destination :</strong> <span id="fr-panel-infos-territory-zipAndName"></span></li>
                        <li><strong>Nombre d'affectations :</strong> <span id="fr-panel-infos-territory-nb-affectations"></span></li>
                        <li><strong>Nombre de suivis :</strong> <span id="fr-panel-infos-territory-nb-suivis"></span></li>
                    </ul>
                </div>
                <div class="fr-mb-2w">
                    <a id="fr-panel-infos-territory-see-signalement" href="#" class="fr-link fr-link--icon-left fr-icon-arrow-right-line" target="_blank" title="Voir le signalement - Ouvre une nouvelle fenêtre">Voir le signalement</a>
                </div>
                <div class="fr-col-12 fr-notice fr-notice--warning">
                    <div class="fr-container">
                        <div class="fr-notice__body">
                            <p>
                                <span class="fr-notice__title">Le territoire du signalement ne correspond pas à l'adresse.</span>
                                <span class="fr-notice__desc">Il n'est pas possible de modifier le territoire simplement. Vous devez préalablement vous assurer de l'impact de cette modification. (affectations, suivis, partenaires etc.) Vous devez aussi vous assurer que le territoire de destination est actif. Puis s'il y a vraiment besoin de modifier le territoire, il faut contacter l'équipe technique.</span>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="fr-col-12 fr-notice fr-notice--warning fr-mt-2w">
                    <div class="fr-container">
                        <div class="fr-notice__body">
                            <p>
                                <span class="fr-notice__title">Une modification de l'adresse sur la fiche signalement suffit peut-être.</span>
                                <span class="fr-notice__desc">Si c'est un problème de codes postal ou de code insee, essayez de modifier l'adresse directement sur la fiche du signalement.</span>
                            </p>
                        </div>
                    </div>
                </div>
                <input type="hidden" id="fr-panel-infos-territory-search-params" value="{{ app.request.query.all|url_encode }}">
            </div>
            <div class="side-panel__footer">
                <div class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-lg fr-btns-group--icon-left">
                    <button class="fr-btn fr-btn--secondary fr-icon-close-line js-close-panel" type="button" data-panel="fr-panel-infos-territory" aria-controls="fr-panel-infos-territory">Fermer</button>
                </div>
            </div>
        </div>
    </dialog>

    <dialog aria-labelledby="fr-panel-bulk-link-address-title" id="fr-panel-bulk-link-address" class="side-panel">
        <div class="side-panel__inner">
            <div class="side-panel__header">
                <button type="button" class="fr-btn--close fr-btn js-close-panel" data-panel="fr-panel-bulk-link-address" aria-controls="fr-panel-bulk-link-address" aria-expanded="false">Fermer</button>
            </div>
            <div class="side-panel__content fr-mx-3w">
                <h1 id="fr-panel-bulk-link-address-title" class="fr-panel__title">Lier les signalements à leur adresse</h1>
                <div id="fr-panel-bulk-link-address-results" aria-live="polite"></div>
                <input type="hidden" id="fr-panel-bulk-link-address-token">
                <input type="hidden" id="fr-panel-bulk-link-address-link-url">
                <input type="hidden" id="fr-panel-bulk-link-address-search-params" value="{{ app.request.query.all|url_encode }}">
            </div>
            <div class="side-panel__footer">
                <div class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-lg fr-btns-group--icon-left">
                    <button class="fr-btn fr-icon-check-line" type="button" id="fr-panel-bulk-link-address-confirm" disabled>Oui, lier ces signalements aux adresses envoyées par la BAN</button>
                    <button class="fr-btn fr-btn--secondary fr-icon-close-line js-close-panel" type="button" data-panel="fr-panel-bulk-link-address" aria-controls="fr-panel-bulk-link-address">Annuler</button>
                </div>
            </div>
        </div>
    </dialog>
{% endblock %}
