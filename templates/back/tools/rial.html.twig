{% extends 'back/base_bo.html.twig' %}

{% block title %}Outil RIAL par BAN ID{% endblock %}

{% block content %}
    <section class="fr-pt-4v">
        {% include 'back/breadcrumb_bo.html.twig' with {
            'level2Title': 'Outils SA',
            'level2Link': '',
            'level2Label': '',
            'level3Title': 'Outil RIAL par BAN ID',
            'level3Link': path('back_tools_rial'),
        } %}
        {% if rial_enable %}
            <div class="fr-alert fr-alert--info fr-mb-5v">
                <p>
                    Plus d'informations sur l'API RIAL (Répertoire Inter-administratif des Locaux) sur data.gouv.fr :
                    <a href="https://www.data.gouv.fr/dataservices/rial-repertoire-inter-administratif-des-locaux" target="_blank" rel="noopener">
                        https://www.data.gouv.fr/dataservices/rial-repertoire-inter-administratif-des-locaux
                    </a>
                </p>
                <hr>
                <p class="fr-mb-4v">Codes natures acceptés par la plateforme :</p>
                <ul>
                    <li><strong>AP</strong> : appartement</li>
                    <li><strong>MA</strong> : maison</li>
                    <li><strong>MP</strong> : maison partagée (maison à cheval sur 2 communes)</li>
                    <li><strong>ME</strong> : maison exceptionnelle d'habitation</li>
                </ul>
            </div>
            <header>
                <div class="fr-grid-row">
                    <div class="fr-col-12 fr-text--left">
                        <h1>Outil RIAL par BAN ID</h1>
                        <p>
                            Entrez un ou plusieurs identifiants BAN pour obtenir les informations RIAL correspondantes.
                        </p>
                    </div>
                </div>
            </header>
            
            <div class="fr-mb-5v">
                {{ form_start(rialForm) }}
                    {{ form_row(rialForm.banIds) }}
                    <div class="fr-grid-row fr-grid-row--middle">
                        {{ form_widget(rialForm.submit) }}
                        <a href="{{ path('back_tools_rial') }}" class="fr-link fr-link--icon-left fr-icon-close-circle-line fr-ml-3v">Réinitialiser les résultats</a>
                    </div>
                {{ form_end(rialForm) }}
            </div>

            {% if results is defined and results|length > 0 %}
                <h2>Résultats ({{ totalFiscalCount }})</h2>

                {% if topoSearches|length > 0 %}
                    <div class="fr-alert fr-alert--warning fr-mb-5v">
                        <p>Certains BAN IDs contiennent des pseudo-codes de voie sur 6 caractères.</p>
                        <p>La recherche RIAL ne peut pas utiliser ces pseudo-codes comme codes TOPO.</p>
                        <p>Vous pouvez effectuer une recherche manuelle dans le référentiel TOPO DGFiP pour chaque voie concernée.</p>
                    </div>
                {% endif %}

                <div class="fr-table fr-table--lg fr-table--bordered">
                    <div class="fr-table__wrapper">
                        <div class="fr-table__container">
                            <div class="fr-table__content">
                                <table>
                                    <thead>
                                    <tr>
                                        <th scope="col">BAN ID</th>
                                        <th scope="col">Identifiant fiscal</th>
                                        <th scope="col">Données locales</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for row in results %}
                                        <tr>
                                            <td class="fr-cell--top">{{ row.ban_id }}</td>
                                            <td class="fr-cell--top">{{ row.identifiant_fiscal }}</td>
                                            <td><pre style="white-space: pre-wrap;">{{ row.local_data }}</pre></td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                {% if topoSearches|length > 0 %}
                    <h2>Recherche TOPO DGFiP ({{ topoSearches|length }})</h2>
                    {% for banId, topoSearchData in topoSearches %}
                        {% set topoForm = topoForms[banId] %}
                        <div class="fr-card fr-card--no-border fr-mb-5v fr-p-4v" style="background-color: var(--background-alt-blue-france)">
                            <h3>Recherche TOPO DGFiP pour {{ banId }}</h3>
                            <p>
                                Département : <strong>{{ topoSearchData.code_dep }}</strong><br>
                                Commune : <strong>{{ topoSearchData.code_commune }}</strong>
                            </p>
                            {{ form_start(topoForm) }}
                                <input type="hidden" name="rial_search[banIds]" value="{{ rialForm.banIds.vars.value }}">
                                {{ form_row(topoForm.libelle) }}
                                {{ form_widget(topoForm.submit_topo) }}
                                {{ form_rest(topoForm) }}
                            {{ form_end(topoForm) }}
                        </div>

                        {% if topoSearchData.searched is defined and topoSearchData.searched %}
                            <h4>Résultats TOPO DGFiP pour {{ banId }}</h4>
                            <p>
                                Département : <strong>{{ topoSearchData.code_dep }}</strong> |
                                Commune : <strong>{{ topoSearchData.code_commune }}</strong> |
                                Recherche : <strong>{{ topoSearchData.libelle }}</strong>
                            </p>
                            {% if topoSearchData.results|length > 0 %}
                                <div class="fr-table fr-table--sm fr-table--bordered">
                                    <div class="fr-table__wrapper">
                                        <div class="fr-table__container">
                                            <div class="fr-table__content">
                                                <table>
                                                    <thead>
                                                        <tr>
                                                            <th scope="col">Code voie</th>
                                                            <th scope="col">Nature de voie</th>
                                                            <th scope="col">Libellé</th>
                                                            <th scope="col">Code BAN potentiel</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        {% for topoRow in topoSearchData.results %}
                                                            <tr>
                                                                <td>{{ topoRow.code_voie }}</td>
                                                                <td>{{ topoRow.nature_de_voie }}</td>
                                                                <td>{{ topoRow.libelle }}</td>
                                                                <td>
                                                                    {% set ban_parts = banId|split('_') %}
                                                                    {% if ban_parts|length >= 3 %}
                                                                        {{ ban_parts[0] }}_{{ topoRow.code_voie }}_{{ ban_parts[2] }}
                                                                    {% else %}
                                                                        {{ topoSearchData.code_dep }}{{ topoSearchData.code_commune }}_{{ topoRow.code_voie }}
                                                                    {% endif %}
                                                                </td>
                                                            </tr>
                                                        {% endfor %}
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% else %}
                                <p class="fr-text--error">Aucune voie TOPO trouvée pour le libellé "{{ topoSearchData.libelle }}" dans la commune {{ topoSearchData.code_dep }}{{ topoSearchData.code_commune }}.</p>
                            {% endif %}
                            <hr class="fr-my-5v">
                        {% endif %}
                    {% endfor %}
                {% endif %}
            {% else %}
                <img alt="BOOH!" src="{{ asset('img/easter/casper.png') }}">
            {% endif %}
        {% else %}
            <div class="fr-alert fr-alert--warning fr-my-5v">
                <p>L'outil RIAL est désactivé.</p>
            </div>
            <img alt="BOOH!" src="{{ asset('img/easter/casper.png') }}">
        {% endif %}
    </section>
{% endblock %} 
