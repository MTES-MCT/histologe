{% if signalement.isV2 %}   
    {% if signalement.debutDesordres is not null %}
        <div class="fr-grid-row fr-mb-3w">
            <div class="fr-col-12 fr-col-md-6">
                <strong>Début des désordres : </strong>
				{{ signalement.debutDesordres.label}}
            </div>
            {% if signalement.hasSeenDesordres is not null %}
                <div class="fr-col-12 fr-col-md-6">
                    <strong>Le tiers a vu les désordres :</strong>
                    {% if signalement.hasSeenDesordres %}
                        {{ picto.picto_yes() }}
                    {% else %}
                        {{ picto.picto_no() }}
                    {% endif %}
                </div>
            {% endif %}
        </div>
    {% endif %}
    {% include 'back/signalement/view/user-declaration-desordre-list.html.twig' %}
{% else %}
    {% include 'back/signalement/view/user-declaration-situations.html.twig' %}
{% endif %}

<hr class="fr-mt-3w">
{% if s3_enable %}
    {% include 'back/signalement/view/photos-documents.html.twig' with {'zonetitle': "Photos et documents de la situation",'filesFilter': 'situation','context': 'situation'} %}
{% else %}
    <div class="fr-alert fr-alert--warning">
        <h3 class="fr-alert__title">Maintenance en cours</h3>
        <p>L'accès aux documents et photos est temporairement désactivé pour maintenance.</p>
    </div>
{% endif %}
