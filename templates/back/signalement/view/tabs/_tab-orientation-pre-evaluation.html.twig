<div class="title-blue-france fr-mb-2v">
    <span class="fr-icon-calendar-event-fill"></span>
    <strong>{{tabOrientationItem.date|date('d/m/Y') }}</strong>
</div>

<div class="fr-p-3w fr-mb-3w fr-frame--grey">
    <div class="fr-grid-row">
        <div class="fr-col-12 fr-mb-4v">
            <h3 class="fr-h5 title-blue-france"><strong>Pré-évaluation automatique</strong></h3>
            <p class="fr-my-2v">Cette évaluation automatique se base sur les informations renseignées par le déclarant. Vous ne pouvez pas la modifier.</p>
        </div>
        <div class="fr-col-lg-6 fr-col-12">
            <h4 class="fr-h6">Criticité du signalement : {{ tabOrientationItem.signalement.score|round(2) }} %</h4>
            {% if tabOrientationItem.signalement.isV2 %}
                <div class="fr-mb-2v">(Score bâtiment : {{ tabOrientationItem.signalement.scoreBatiment|round(2) }} % - Score logement : {{ tabOrientationItem.signalement.scoreLogement|round(2) }} %)</div>
            {% endif %}
            <a class="fr-link"
                href="https://documentation.signal-logement.beta.gouv.fr/partenaires/premiers-pas-sur-histologe/presentation-de-linterface#score-de-criticite-et-prequalification-comment-ca-marche"
                target="_blank" rel="noreferrer noopener"
                title="En savoir plus - Ouvre une nouvelle fenêtre">En savoir plus</a>
        </div>
        <div class="fr-col-lg-6 fr-col-12">
            <h4 class="fr-h6">Situation(s) suspectée(s)</h4>
            {% for qualification in tabOrientationItem.signalement.signalementQualifications(excludePostVisite: true) %}
                {% include '_partials/signalement/qualification.html.twig' %}
            {% endfor %}
        </div>
    </div>
</div>