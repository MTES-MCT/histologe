<div class="title-blue-france fr-my-3v">
    <span class="fr-icon-calendar-event-fill"></span>
    <strong>{{tabOrientationItem.date|date('d/m/Y') }}</strong>
</div>

<div class="fr-p-3w fr-mb-3w fr-frame--grey">
    <div class="fr-grid-row">
        <div class="fr-col-12 fr-mb-4v">
            <h3 class="fr-h5 title-blue-france">Procédure(s) retenue(s)</h3>
            <p class="fr-my-2v">Retrouvez les procédures retenues sur le dossier telles qu’indiquées à la fermeture du dossier.</p>
        </div>
        <div class="fr-col-lg-6 fr-col-12">
            <h4 class="fr-h6">Procédure(s) retenue(s)</h4>
            {% for signalementProcedure in tabOrientationItem.signalement.signalementProcedures(enum('App\\Entity\\Enum\\ProcedureCategory').PROCEDURE_RETENUE) %}
                {% include '_partials/signalement/procedure.html.twig' with {'procedure': signalementProcedure.procedureType} %}
            {% else %}
                <i>Aucune procédure sélectionnée</i>
            {% endfor %}
        </div>
        <div class="fr-col-lg-6 fr-col-12">
            <h4 class="fr-h6">Commentaire</h4>
            <div class="fr-highlight fr-ml-1v">{{ tabOrientationItem.signalement.comCloture|raw }}</div>
        </div>
    </div>
</div>
