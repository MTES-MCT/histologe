{% if personalNote and personalNote.content %}
    <div class="signalement-personal-note-display">
        <div class="fr-p-3w fr-background-alt--grey fr-mb-3v">{{ personalNote.content|raw }}</div>
        <ul class="fr-btns-group fr-btns-group--inline fr-btns-group--icon-left">
            <li>
                <button type="button" class="fr-btn fr-btn--secondary fr-btn--icon-left fr-icon-edit-line signalement-personal-note-edit-btn">
                    Modifier
                </button>
            </li>
            <li>
                <div class="single-ajax-form-container">
                    <form method="POST" action="{{ path('back_signalement_delete_personal_note', {uuid: signalement.uuid}) }}" data-submit-type="formData">
                        <input type="hidden" name="_token" value="{{ csrf_token('signalement_delete_personal_note') }}">
                        <button type="submit" class="fr-btn fr-btn--secondary fr-btn--icon-left fr-icon-delete-line">
                            Supprimer
                        </button>
                    </form>
                </div>
            </li>
        </ul>
    </div>
    <div class="signalement-personal-note-edit fr-hidden">
        <div class="single-ajax-form-container">
            <form method="POST" action="{{ path('back_signalement_save_personal_note', {uuid: signalement.uuid}) }}" data-submit-type="formData">
                <div class="fr-input-group">
                    <label class="fr-label" for="personal-note-content">Votre note personnelle</label>
                    <textarea class="fr-input editor" id="personal-note-content" name="content" rows="8">{{ personalNote.content|raw }}</textarea>
                </div>
                <input type="hidden" name="_token" value="{{ csrf_token('signalement_save_personal_note') }}">
                <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline fr-btns-group--icon-left">
                    <li>
                        <button class="fr-btn fr-btn--icon-left fr-icon-check-line" type="submit">Enregistrer</button>
                    </li>
                    <li>
                        <button type="button" class="fr-btn fr-btn--secondary fr-btn--icon-left fr-icon-close-line signalement-personal-note-cancel-btn">Annuler</button>
                    </li>
                </ul>
            </form>
        </div>
    </div>
{% else %}
    <div class="signalement-personal-note-edit">
        <div class="single-ajax-form-container">
            <form method="POST" action="{{ path('back_signalement_save_personal_note', {uuid: signalement.uuid}) }}" data-submit-type="formData">
                <div class="fr-input-group">
                    <label class="fr-label" for="personal-note-content">Votre note personnelle</label>
                    <textarea class="fr-input editor" id="personal-note-content" name="content" rows="8" placeholder="Saisissez votre note personnelle..."></textarea>
                </div>
                <input type="hidden" name="_token" value="{{ csrf_token('signalement_save_personal_note') }}">
                <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline fr-btns-group--icon-left">
                    <li>
                        <button class="fr-btn fr-btn--icon-left fr-icon-check-line" type="submit">Enregistrer</button>
                    </li>
                </ul>
            </form>
        </div>
    </div>
{% endif %}
