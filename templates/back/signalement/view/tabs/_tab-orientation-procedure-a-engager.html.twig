<div class="title-blue-france fr-my-3v">
    <span class="fr-icon-calendar-event-fill"></span>
    <strong>{{ tabOrientationItem.date|date('d/m/Y') }}</strong>
</div>

<div class="fr-p-3w fr-mb-3w {% if is_granted('SIGN_MANAGE_PROCEDURE_ENGAGEE') %}fr-frame--white{% else %}fr-frame--grey{% endif %}">
    <div class="fr-grid-row">
        <div class="fr-col-12 fr-mb-4v">
            <div class="fr-grid-row fr-grid-row--middle fr-grid-row--gutters">
                <div class="fr-col">
                    <h3 class="fr-h5 title-blue-france">Procédure(s) à engager</h3>
                </div>
                <div class="fr-col-auto">
                    {% if is_granted('SIGN_MANAGE_PROCEDURE_ENGAGEE', tabOrientationItem.signalement) %}
                        {% if tabOrientationItem.signalement.signalementProcedures(enum('App\\Entity\\Enum\\ProcedureCategory').PROCEDURE_ENGAGEE)|length == 0 %}
                            <button class="fr-btn fr-btn--secondary fr-btn--icon-left fr-icon-add-line" data-panel-open="panel-edit-procedure-engagee" aria-controls="panel-edit-procedure-engagee" aria-expanded="false">
                                Ajouter
                            </button>
                        {% else %}
                            <button class="fr-btn fr-btn--secondary fr-btn--icon-left fr-icon-delete-bin-line" data-panel-open="panel-delete-procedure-engagee" aria-controls="panel-delete-procedure-engagee" aria-expanded="false">
                                Supprimer
                            </button>
                            <button class="fr-btn fr-btn--secondary fr-btn--icon-left fr-icon-edit-line" data-panel-open="panel-edit-procedure-engagee" aria-controls="panel-edit-procedure-engagee" aria-expanded="false">
                                Modifier
                            </button>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
            <p class="fr-my-2v">Indiquez les procédures engagées ou à engager sur le dossier.</p>
        </div>
        <div class="fr-col-lg-6 fr-col-12">
            <h4 class="fr-h6">Procédure(s) à engager</h4>
            {% for signalementProcedure in tabOrientationItem.signalement.signalementProcedures(enum('App\\Entity\\Enum\\ProcedureCategory').PROCEDURE_ENGAGEE) %}
                {% include '_partials/signalement/procedure.html.twig' with {'procedure': signalementProcedure.procedureType} %}
            {% else %}
                <i>Aucune procédure sélectionnée</i>
            {% endfor %}
        </div>
        <div class="fr-col-lg-6 fr-col-12">
            <h4 class="fr-h6">Commentaire</h4>
            {% if tabOrientationItem.signalement.signalementProcedures(enum('App\\Entity\\Enum\\ProcedureCategory').PROCEDURE_ENGAGEE)|length > 0 %}
                {% set lastSuivi = tabOrientationItem.signalement.getSuivisWithCategory(constant('App\\Entity\\Enum\\SuiviCategory::ADD_OR_EDIT_PROCEDURE_ENGAGEE')).last() %}
                {% set commentaire = lastSuivi ? (lastSuivi.getOriginalData()['commentaire']) : null %}
                {% if commentaire %}
                    <div class="fr-highlight fr-ml-1v">
                        {{ commentaire|raw }}
                    </div>
                {% endif %}
            {% endif %}
        </div>
    </div>
</div>