{% set userTags = app.user.personalTags|sort((a, b) => a.label|lower <=> b.label|lower) %}
{% set selectedPersonalTags = signalement.personalTags|filter(personalTag => personalTag.user and personalTag.user.id == app.user.id) %}
{% set selectedPersonalTagIds = selectedPersonalTags|map(personalTag => personalTag.id) %}
<div class="fr-grid-row fr-grid-row--gutters search-and-select-badges-container" data-autosubmit="1">
    <div class="fr-col-12 fr-col-md-6">
        <h4 class="fr-h6">Ajouter une étiquette</h4>
        <p class="fr-text--sm">
            Saisissez une nouvelle étiquette ou sélectionnez-en une existante dans la liste.
        </p>
        <div class="single-ajax-form-container">
            <form method="POST" action="{{ path('back_signalement_create_personal_tag', {uuid: signalement.uuid}) }}" class="fr-search-bar fr-search-bar-customized" data-submit-type="formData">
                <label class="fr-label" for="personal-tag-filter-input">Recherche</label>
                <input class="fr-input search-and-select-badges-search-input" placeholder="Rechercher" type="text" id="personal-tag-filter-input" name="label">
                <button class="fr-btn fr-icon-arrow-left-line" type="submit" title="Rechercher">Rechercher</button>
                <input type="hidden" name="_token" value="{{ csrf_token('signalement_create_personal_tag') }}">
            </form>
            <span class="fr-hidden" data-error-target="1"></span>
        </div>
        <div class="fr-my-3v">
            {% for tag in userTags %}
                <span
                    class="fr-badge fr-m-1v search-and-select-badge-add search-and-select-badge-add-{{ tag.id }} {% if tag.id in selectedPersonalTagIds %}fr-hidden disabled{% endif %}"
                    data-badge-id="{{ tag.id }}" data-badge-label="{{ tag.label }}"
                    >{{ tag.label }} <span class="fr-icon-add-line" aria-hidden="true"></span></span>
            {% else %}
                <em class="fr-text-default--warning fr-fi-close-line fr-icon--xs">
                    <small>Vous n'avez pas encore d'étiquette personnelle.</small>
                </em>
            {% endfor %}
        </div>
    </div>
    <div class="fr-col-12 fr-col-md-6">
        <h4 class="fr-h6">Étiquettes du dossier</h4>
        <p class="fr-text--sm">
            Cliquez sur une étiquette pour la retirer du dossier. Les changements sont enregistrés automatiquement.
        </p>
        <div class="search-and-select-badges-selected fr-my-3v">
            {% for tag in selectedPersonalTags %}
                <span
                    class="fr-badge fr-badge--blue-ecume fr-m-1v search-and-select-badge-remove"
                    data-badge-id="{{ tag.id }}"
                    >{{ tag.label }} <span class="fr-icon-close-line" aria-hidden="true"></span></span>
            {% else %}
                <em class="search-and-select-badges-no-selection fr-text-default--warning fr-fi-close-line fr-icon--xs">
                    <small>Aucune étiquette attribuée à ce signalement.</small>
                </em>
            {% endfor %}
        </div>
        <div class="single-ajax-form-container">
            <form method="POST" action="{{ path('back_signalement_save_personal_tags', {uuid: signalement.uuid}) }}" id="form-signalement-save-personal-tags" data-submit-type="formData">
                <input type="hidden" class="search-and-select-badges-input" name="tag-ids" value="{% for tag in selectedPersonalTags %}{{ tag.id }},{% endfor %}">
                <input type="hidden" name="_token" value="{{ csrf_token('signalement_save_personal_tags') }}">
            </form>
        </div>
    </div>
</div>
