<h2 class="fr-h4">Orientation du dossier</h2>
<p>Retrouvez les observations générales, les conclusions de visite et indiquez les procédures à engager sur le dossier.</p>

{% for tabOrientationItem in tabOrientationItems %}
    {% if tabOrientationItem.type is same as constant('App\\Service\\Signalement\\TabOrientation\\TabOrientationItem::TYPE_PROCEDURE_RETENUE') %}
        {% include 'back/signalement/view/tabs/_tab-orientation-procedure-retenue.html.twig' %}
    {% elseif tabOrientationItem.type is same as constant('App\\Service\\Signalement\\TabOrientation\\TabOrientationItem::TYPE_PROCEDURE_A_ENGAGER') %}
        {% include 'back/signalement/view/tabs/_tab-orientation-procedure-a-engager.html.twig' %}
    {% elseif tabOrientationItem.type is same as constant('App\\Service\\Signalement\\TabOrientation\\TabOrientationItem::TYPE_CONCLUSION_DE_VISITE') %}
        {% include 'back/signalement/view/tabs/_tab-orientation-conclusion-visite.html.twig' %}
    {% elseif tabOrientationItem.type is same as constant('App\\Service\\Signalement\\TabOrientation\\TabOrientationItem::TYPE_PRE_EVALUATION') %}
        {% include 'back/signalement/view/tabs/_tab-orientation-pre-evaluation.html.twig' %}
    {% endif %}
{% endfor %}