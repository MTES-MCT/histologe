{% if signalement.affectations|length %}
    <div class="fr-grid-row fr-grid-row--gutters">
        {% for partnerAffectation in signalement.affectations %}
            <div class="fr-col-12 fr-col-md-6 partner-row">
                <div class="fr-mb-3v fr-p-3v fr-background-alt--grey">
                    <div class="fr-grid-row fr-grid-row--middle">
                        <div class="fr-col-12 fr-col-lg-7">
                            {{ partnerAffectation.partner ? partnerAffectation.partner.nom : 'AUCUN' }}
                            <br>
                            {% if partnerAffectation.statut is same as enum('App\\Entity\\Enum\\AffectationStatus').CLOSED %}
                                <span class="fr-hint-text">
                                    Clôturé le {{ partnerAffectation.answeredAt|date('d/m/Y') }}
                                    <br>
                                    {{ partnerAffectation.answeredBy ? 'par ' ~ partnerAffectation.answeredBy.nomComplet }}
                                </span>
                            {% elseif partnerAffectation.statut is same as enum('App\\Entity\\Enum\\AffectationStatus').ACCEPTED %}
                                <span class="fr-hint-text">
                                    Accepté le {{ partnerAffectation.answeredAt|date('d/m/Y') }}
                                    <br>
                                    {{ partnerAffectation.answeredBy ? 'par ' ~ partnerAffectation.answeredBy.nomComplet }}
                                </span>
                            {% elseif partnerAffectation.statut is same as enum('App\\Entity\\Enum\\AffectationStatus').REFUSED %}
                                <span class="fr-hint-text">
                                    Refusé le {{ partnerAffectation.answeredAt|date('d/m/Y') }}
                                    <br>
                                    {{ partnerAffectation.answeredBy ? 'par ' ~ partnerAffectation.answeredBy.nomComplet }}
                                </span>
                            {% else %}
                                <span class="fr-hint-text">
                                    Affecté le {{ partnerAffectation.createdAt|date('d/m/Y') }}
                                    <br>
                                    {{ partnerAffectation.affectedBy ? 'par ' ~ partnerAffectation.affectedBy.nomComplet }}
                                </span>
                            {% endif %}
                        </div>
                        <div class="fr-col-10 fr-col-lg-3">
                            <div>
                                {% if partnerAffectation.statut is same as enum('App\\Entity\\Enum\\AffectationStatus').WAIT %}
                                    <span class="fr-badge fr-badge--sm {{ partnerAffectation.statut.badgeClass }}">En attente</span>
                                {% elseif partnerAffectation.statut is same as enum('App\\Entity\\Enum\\AffectationStatus').ACCEPTED %}
                                    <span class="fr-badge fr-badge--sm {{ partnerAffectation.statut.badgeClass }}">Acceptée</span>
                                {% elseif partnerAffectation.statut is same as enum('App\\Entity\\Enum\\AffectationStatus').REFUSED %}
                                    <span class="fr-badge fr-badge--sm fr-fi-close-line {{ partnerAffectation.statut.badgeClass }}">Refusée</span>
                                {% elseif partnerAffectation.statut is same as enum('App\\Entity\\Enum\\AffectationStatus').CLOSED %}
                                    <span class="fr-badge fr-badge--sm fr-fi-close-circle-fill">Clôturée</span>
                                {% endif %}
                                {% if not partnerAffectation.partner.receiveEmailNotifications %}
                                    <span class="fr-badge fr-badge--warning fr-badge--sm">Notif. e-mail désactivées</span>
                                {% endif %}
                                {% if partnerEmailAlerts[partnerAffectation.partner.id] %}
                                    <span class="fr-badge fr-badge--warning fr-badge--sm">Problème d'e-mail non remis</span>
                                {% endif %}
                            </div>

                            {% if syncStatuses[partnerAffectation.partner.id] is defined %}
                                <div>
                                    <span class="fr-badge fr-badge--warning fr-badge--sm">Syncro.</span>
                                    <button class="fr-btn--tooltip fr-btn" type="button" aria-describedby="tooltip_sync_{{ partnerAffectation.id }}"
                                        title="Voir les erreurs de synchronisation"
                                        >Voir les erreurs de synchronisation</button>
                                    <span class="fr-tooltip fr-placement" id="tooltip_sync_{{ partnerAffectation.id }}" role="tooltip">
                                        <p class="fr-text--sm">
                                            {% if 'push' in syncStatuses[partnerAffectation.partner.id].last_job_event_action %}
                                                Echec de l'envoi de dossier.
                                            {% elseif 'sync' in syncStatuses[partnerAffectation.partner.id].last_job_event_action %}
                                                Echec de la synchronisation du dossier.
                                            {% endif %}
                                            <br>
                                            Détails : 
                                            {% if syncStatuses[partnerAffectation.partner.id].last_job_event_response is not empty %}
                                                {{ syncStatuses[partnerAffectation.partner.id].last_job_event_response }}
                                            {% else %}
                                                Aucune information disponible.
                                            {% endif %}
                                            <br>
                                            <a href="{{ path('back_interconnexion_index', { territory: signalement.address.territory.id, reference: signalement.reference, status: 'failed', partner: partnerAffectation.partner.id }) }}" class="fr-link" target="_blank">Voir le journal de synchronisation</a>
                                        </p>
                                    </span>
                                </div>
                            {% endif %}
                        </div>
                        <div class="fr-col-2 fr-text--right">
                            {% if is_granted('AFFECTATION_REINIT', partnerAffectation) %}
                                <button 
                                    title="Réaffecter le partenaire" 
                                    class="fr-btn fr-btn--sm fr-btn--secondary fr-icon-refresh-line open-modal-reinit-affectation"
                                    data-fr-opened="false" 
                                    aria-controls="fr-modal-reinit-affectation"
                                    data-partner-nom="{{ partnerAffectation.partner.nom }}"
                                    data-action="{{ path('back_signalement_affectation_reinit', {affectation: partnerAffectation.id}) }}"
                                    >
                                </button>
                            {% endif %}
                            {% if signalement.statut is not same as enum('App\\Entity\\Enum\\SignalementStatus').CLOSED %}
                                <button title="Désaffecter le partenaire"
                                        data-delete="{{ path('back_signalement_remove_partner',{uuid:signalement.uuid,affectation:partnerAffectation.id}) }}"
                                        data-is-synchronized="{{ partnerAffectation.isSynchronized and partnerAffectation.statut is same as enum('App\\Entity\\Enum\\AffectationStatus').ACCEPTED ? 1 : 0 }}"
                                        data-token="{{ csrf_token('signalement_remove_partner_'~signalement.id) }}"
                                        data-move-affectation-partner-id="{{ partnerAffectation.partner.id }}"
                                        class="fr-btn fr-btn--sm fr-btn--secondary fr-fi-delete-line partner-row-delete"></button>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
