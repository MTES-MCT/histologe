<dialog aria-labelledby="panel-reinit-affectation-title" id="panel-reinit-affectation" data-panel-visite="true" class="side-panel">
    <div class="side-panel__inner">
        <div class="side-panel__header">
            <button type="button" class="fr-btn--close fr-btn js-close-panel" data-panel="panel-reinit-affectation" aria-controls="panel-reinit-affectation" aria-expanded="false">Fermer</button>
        </div>

        <div class="side-panel__content fr-mx-3w">
            <h1 id="panel-reinit-affectation-title" class="fr-modal__title title-blue-france"
                >Réaffecter le partenaire <span class="partner-nom"></span></h1>
                <p>Voulez-vous vraiment réaffecter ce partenaire ?</p>
                <form id="form-reinit-affectation" action="" method="POST" data-submit-type="formData">
                    <input type="hidden" name="_token" value="{{ csrf_token('reinit_affectation_'~signalement.uuid) }}">
                </form>
        </div>
        <div class="side-panel__footer">
            <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-sm fr-btns-group--icon-left">
                <li>
                    <button type="submit"
                        class="fr-btn fr-btn--icon-left fr-icon-check-line"
                        form="form-reinit-affectation"
                        >Valider</button>
                </li>
                <li>
                    <button type="button"
                        class="fr-btn fr-btn--secondary fr-icon-close-line js-close-panel"
                        data-panel="panel-reinit-affectation"
                        aria-controls="panel-reinit-affectation"
                        aria-expanded="false"
                        >Annuler</button>
                </li>
            </ul>
        </div>
    </div>
</dialog>