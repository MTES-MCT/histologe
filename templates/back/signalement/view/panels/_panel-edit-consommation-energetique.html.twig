<div data-ajax-form>
    <dialog aria-labelledby="panel-edit-consommation-energetique-title" id="panel-edit-consommation-energetique" class="side-panel">
        <div class="side-panel__inner">
            <div class="side-panel__header">
                <button type="button" class="fr-btn--close fr-btn js-close-panel" data-panel="panel-edit-consommation-energetique" aria-controls="panel-edit-consommation-energetique" aria-expanded="false">Fermer</button>
            </div>
            <div class="side-panel__content fr-mx-3w">
                <h1 id="panel-edit-consommation-energetique-title" class="fr-modal__title title-blue-france">Non décence énergétique</h1>

                <p>
                    Validez les informations pour savoir si le logement dépasse le seuil de non décence énergétique ou non.
                    <br>
                    Les champs marqués d'un astérisque (<span class="text-required">*</span>) sont obligatoires.
                </p>    
                <p class="fr-mt-3v fr-alert fr-alert--warning">
                    Si le dernier bail a été établi avant 2023, le logement n'est pas concerné par 
                    la nouvelle législation sur la non décence énergétique. Vous n'aurez plus accès à ces infos.
                </p>

                <div class="fr-grid-row fr-grid-row--center fr-grid-row--middle fr-h-100 fr-hidden fr-mt-5w"
                        id="signalement-edit-consommation-energetique-loader-row">
                    <div class="fr-col-12 fr-text--center">
                        <div class="lds-histologe">
                            <div></div>
                            <div></div>
                            <div></div>
                        </div>
                    </div>
                </div>
                <form method="POST" name="signalement-edit-consommation-energetique" id="signalement-edit-consommation-energetique-form" enctype="application/json"
                    action="{{ path('back_signalement_edit_consommation_energetique',{uuid:signalement.uuid}) }}"
                    >
                    {# Valeurs issues de la qualification NDE si elle existe, sinon des informations du logement #}
                    {% set typeCompositionLogement = signalement.typeCompositionLogement %}
                    {% set dpe = null %}
                    {% set dpeNsp = false %}
                    {% set isDPEBefore2023 = null %}
                    {% set consommationEnergie = null %}
                    {% if signalementQualificationNDE and signalementQualificationNDE.details %}
                        {% set dpe = signalementQualificationNDE.details.DPE ?? null %}
                        {% set dpeNsp = dpe is null or dpe is same as '' %}
                        {% set dateDernierDpe = signalementQualificationNDE.details.date_dernier_dpe ?? null %}
                        {% if dateDernierDpe in ['before2023', 'post2023'] %}
                            {% set isDPEBefore2023 = dateDernierDpe is same as 'before2023' %}
                        {% elseif dateDernierDpe %}
                            {% set isDPEBefore2023 = dateDernierDpe|date('Y') < 2023 %}
                        {% endif %}
                        {% set consommationEnergie = signalementQualificationNDE.details.consommation_energie ?? null %}
                    {% elseif typeCompositionLogement %}
                        {% if typeCompositionLogement.bailDpeDpe is same as 'oui' %}
                            {% set dpe = true %}
                        {% elseif typeCompositionLogement.bailDpeDpe is same as 'non' %}
                            {% set dpe = false %}
                        {% elseif typeCompositionLogement.bailDpeDpe is same as 'nsp' %}
                            {% set dpeNsp = true %}
                        {% endif %}
                        {% if typeCompositionLogement.desordresLogementChauffageDetailsDpeAnnee is same as 'before2023' %}
                            {% set isDPEBefore2023 = true %}
                            {% set consommationEnergie = typeCompositionLogement.desordresLogementChauffageDetailsDpeConso %}
                        {% elseif typeCompositionLogement.desordresLogementChauffageDetailsDpeAnnee is same as 'post2023' %}
                            {% set isDPEBefore2023 = false %}
                            {% set consommationEnergie = typeCompositionLogement.desordresLogementChauffageDetailsDpeConsoFinale %}
                        {% endif %}
                    {% endif %}

                    <fieldset class="fr-fieldset fr-fieldset--inline">
                        <legend class="fr-fieldset__legend fr-text--regular" id='signalement-edit-consommation-energetique-dpe-legend'>
                            DPE Disponible ? <span class="text-required">*</span>
                        </legend>
                        <p id="signalement-edit-consommation-energetique-dpe-error" class="fr-error-text static-error fr-hidden fr-my-3v">
                            Veuillez préciser la disponibilité du DPE.
                        </p>
                        <div class="fr-fieldset__content">
                            <div class="fr-radio-group">
                                <input type="radio" id="signalement-edit-consommation-energetique-dpe-1" name="dpe" value='1' {% if dpe is same as true or dpe is same as 1 or dpe is same as '1' %}checked{% endif %}>
                                <label class="fr-label" for="signalement-edit-consommation-energetique-dpe-1">Oui
                                </label>
                            </div>
                            <div class="fr-radio-group">
                                <input type="radio" id="signalement-edit-consommation-energetique-dpe-0" name="dpe" value='0' {% if dpe is same as false or dpe is same as 0 or dpe is same as '0' %}checked{% endif %}>
                                <label class="fr-label" for="signalement-edit-consommation-energetique-dpe-0">Non
                                </label>
                            </div>
                            <div class="fr-radio-group">
                                <input type="radio" id="signalement-edit-consommation-energetique-dpe-2" name="dpe" value='null' {% if dpeNsp %}checked{% endif %}>
                                <label class="fr-label" for="signalement-edit-consommation-energetique-dpe-2">Ne sait pas
                                </label>
                            </div>
                        </div>
                    </fieldset>

                    <div class="fr-select-group">
                        {% set bailDpeClasseEnergetique = signalement.typeCompositionLogement ? signalement.typeCompositionLogement.bailDpeClasseEnergetique : null %}
                        <label class="fr-label" for="signalement-edit-consommation-energetique-classe-energetique">Classe énergétique</label>
                        <select class="fr-select" id="signalement-edit-consommation-energetique-classe-energetique" name="bailDpeClasseEnergetique">
                            <option value="" {{ bailDpeClasseEnergetique not in ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'nsp'] ? 'selected' : '' }}></option>
                            <option value="A" {{ bailDpeClasseEnergetique is same as 'A' ? 'selected' : '' }}>A</option>
                            <option value="B" {{ bailDpeClasseEnergetique is same as 'B' ? 'selected' : '' }}>B</option>
                            <option value="C" {{ bailDpeClasseEnergetique is same as 'C' ? 'selected' : '' }}>C</option>
                            <option value="D" {{ bailDpeClasseEnergetique is same as 'D' ? 'selected' : '' }}>D</option>
                            <option value="E" {{ bailDpeClasseEnergetique is same as 'E' ? 'selected' : '' }}>E</option>
                            <option value="F" {{ bailDpeClasseEnergetique is same as 'F' ? 'selected' : '' }}>F</option>
                            <option value="G" {{ bailDpeClasseEnergetique is same as 'G' ? 'selected' : '' }}>G</option>
                            <option value="nsp" {{ bailDpeClasseEnergetique is same as 'nsp' ? 'selected' : '' }}>Je ne sais pas</option>
                        </select>
                    </div>

                    <div class="fr-input-group fr-mt-3w" id="signalement-edit-consommation-energetique-date-entree-container">
                        {% block date_entree_field %}
                        {% set dateEntree = '' %}
                        {% if signalement.dateEntree %}
                            {% set dateEntree = signalement.dateEntree.format('Y-m-d') %}
                        {% endif %}
                        <label class="fr-label" for="signalement-edit-consommation-energetique-date-entree">Entrée dans le logement <span class="text-required">*</span>
                        </label>
                        <p id="signalement-edit-consommation-energetique-date-entree-error" class="fr-error-text static-error fr-hidden fr-my-3v">
                            Veuillez préciser la date d'entrée dans le logement.
                        </p>
                        <input class="fr-input"
                            type="date"
                            id="signalement-edit-consommation-energetique-date-entree"
                            name="dateEntree"
                            value="{{ dateEntree }}">
                        {% endblock %}
                    </div>
                    
                    <fieldset class="fr-fieldset fr-fieldset--inline">
                        <legend class="fr-fieldset__legend fr-text--regular" id='signalement-edit-consommation-energetique-dpe-date-legend'>
                            Date du dernier DPE
                        </legend>
                        <div class="fr-fieldset__content">
                            <div class="fr-radio-group">
                                <input type="radio" id="signalement-edit-consommation-energetique-dpe-date-before" name="dateDernierDPE" value="1970-01-01" {% if isDPEBefore2023 is same as true %}checked{% endif %}>
                                <label class="fr-label" for="signalement-edit-consommation-energetique-dpe-date-before">Avant 2023
                                </label>
                            </div>
                            <div class="fr-radio-group">
                                <input type="radio" id="signalement-edit-consommation-energetique-dpe-date-after" name="dateDernierDPE" value="2023-01-02" {% if isDPEBefore2023 is same as false %}checked{% endif %}>
                                <label class="fr-label" for="signalement-edit-consommation-energetique-dpe-date-after">A partir de 2023
                                </label>
                            </div>
                        </div>
                    </fieldset>

                    {# Les champs consommation et superficie ne sont affichés qu'une fois la date du dernier DPE sélectionnée #}
                    <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--middle fr-my-3w {% if isDPEBefore2023 is null %}fr-hidden{% endif %}" id="signalement-edit-consommation-energetique-form-row">
                        {# Si date de DPE à partir du 01/01/2023 -> On affiche un champ unique kWh/m²/an sur toute la largeur #}
                        {% set isDPE2023 = isDPEBefore2023 is same as false %}
                        <div class="{% if isDPE2023 %}fr-col-12{% else %}fr-col-6{% endif %} field-consommation-energetique-conso-energie">
                            <div class="fr-input-group">
                                <label class="fr-label" for="signalement-edit-consommation-energetique-conso-energie">
                                    Consommation énergétique
                                </label>
                                <input class="fr-input fr-col-9 fr-display-inline" pattern="[0-9]*" inputmode="numeric" type="number" id="signalement-edit-consommation-energetique-conso-energie" name="consommationEnergie" value="{{ consommationEnergie }}" >
                                kWh<span class="{% if not isDPE2023 %}fr-hidden{% endif %} field-consommation-energetique-conso-energie-unity">/m²</span>/an
                            </div>
                        </div>
                        <div class="{% if isDPE2023 %}fr-hidden{% else %}fr-col-6{% endif %} field-consommation-energetique-superficie">
                            <div class="fr-input-group" id="signalement-edit-consommation-energetique-superficie-container">
                                {% block superficie_field %}
                                <label class="fr-label" for="signalement-edit-consommation-energetique-superficie">
                                    Superficie du logement
                                </label>
                                <input class="fr-input fr-col-10 fr-display-inline" pattern="[0-9]*" type="number" id="signalement-edit-consommation-energetique-superficie" name="superficie" value="{{signalement.superficie}}" max="9999"> m²
                                <p id="signalement-edit-consommation-energetique-superficie-error" class="fr-error-text static-error fr-hidden">La superficie ne doit pas dépasser 9999 m².</p>
                                {% endblock %}
                            </div>
                        </div>
                    </div>                            
                    <input type="hidden" name="_token" id="signalement-edit-consommation-energetique-token" value="{{ csrf_token('signalement_edit_consommation_energetique_'~signalement.id) }}">
                </form>
            </div>
            <div class="side-panel__footer">
                <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-sm fr-btns-group--icon-left">
                    <li>
                        <button type="button" class="fr-btn fr-btn--icon-left fr-icon-check-line" id="signalement-edit-consommation-energetique-form-submit"
                            >Valider</button>
                    </li>
                    <li>
                        <button class="fr-btn fr-btn--secondary fr-icon-close-line js-close-panel" data-panel="panel-edit-consommation-energetique" aria-controls="panel-edit-consommation-energetique" aria-expanded="false" type="button"
                            >Annuler</button>
                    </li>
                </ul>
            </div>
        </div>
    </dialog>
</div>