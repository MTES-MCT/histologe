<dialog aria-labelledby="panel-transfer-subscription-title" id="panel-transfer-subscription" data-panel-visite="true" class="side-panel">
    <div class="side-panel__inner">
        <div class="side-panel__header">
            <button type="button" class="fr-btn--close fr-btn js-close-panel" data-panel="panel-transfer-subscription" aria-controls="panel-transfer-subscription" aria-expanded="false">Fermer</button>
        </div>

        <div class="side-panel__content fr-mx-3w">
            <h1 id="panel-transfer-subscription-title" class="fr-modal__title title-blue-france"
                >Veuillez attribuer le dossier #{{ signalement.reference }} à un autre agent</h1>

            <div class="fr-alert fr-alert--info fr-alert--sm fr-mb-3v">
                <p>Si votre partenaire {{partner.nom}} a terminé son travail sur le dossier, veuillez clôturer le dossier</p>
            </div>
            <p>
                Vous êtes le dernier agent de votre partenaire {{partner.nom}} à recevoir les notifications de ce dossier.<br>
                Avant de quitter le dossier, veuillez sélectionner un ou plusieurs agents de votre partenaire à qui l'attribuer.
                Pour attribuer le dossier à tous les agents, cliquez sur "Tout sélectionner".
            </p>
            {{ form_start(transferSubscriptionForm, {'attr': {'id': 'form-transfer-subscription', 'data-submit-type':'formData'}}) }}
            <div class="fr-mb-2v">
                <button id="select-all-agents-transfer-subscription" data-select-all-in-target=".agent-transfer-container"  class="fr-link">Tout sélectionner</button>
            </div>
            {{ form_errors(transferSubscriptionForm) }}
            <div class="fr-select-group agent-transfer-container">
                {{ form_label(transferSubscriptionForm.agents, null, {'label_attr': {'class': 'fr-mb-2v', 'name': 'agent_selection[agents]', 'data-error-target': '1'}}) }}
                <div class="fr-grid-row">
                    {% for agent in transferSubscriptionForm.agents %}
                        <div class="fr-checkbox-group fr-col-6">
                            {{ form_row(agent, {'id': 'transfer_subscription_' ~ agent.vars.value}) }}
                        </div>
                    {% endfor %}
                </div>
            </div>
            {{ form_end(transferSubscriptionForm) }}
        </div>
        <div class="side-panel__footer">
            <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-sm fr-btns-group--icon-left">
                <li>
                    <button type="submit"
                        class="fr-btn fr-btn--icon-left fr-icon-check-line"
                        form="form-transfer-subscription"
                        >Valider</button>
                </li>
                <li>
                    <button type="button"
                        class="fr-btn fr-btn--secondary fr-icon-close-line js-close-panel"
                        data-panel="panel-transfer-subscription"
                        aria-controls="panel-transfer-subscription"
                        aria-expanded="false"
                        >Annuler</button>
                </li>
            </ul>
        </div>
    </div>
</dialog>