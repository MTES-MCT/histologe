<dialog aria-labelledby="panel-reopen{% if all == '1' %}-all{% endif %}-signalement-title" id="panel-reopen{% if all == '1' %}-all{% endif %}-signalement" data-panel-visite="true" class="side-panel">
    <div class="side-panel__inner">
        <div class="side-panel__header">
            <button type="button" class="fr-btn--close fr-btn js-close-panel" data-panel="panel-reopen{% if all == '1' %}-all{% endif %}-signalement" aria-controls="panel-reopen{% if all == '1' %}-all{% endif %}-signalement" aria-expanded="false">Fermer</button>
        </div>

        <div class="side-panel__content fr-mx-3w">
            <h1 id="panel-reopen{% if all == '1' %}-all{% endif %}-signalement-title" class="fr-modal__title title-blue-france"
                >{% if all == '1' %}
                    Rouvrir le signalement pour tous
                {% else %}
                    Rouvrir pour {{ app.user.partnerInTerritoryOrFirstOne(signalement.territory) ? app.user.partnerInTerritoryOrFirstOne(signalement.territory).nom : 'N/A' }}
                {% endif %}</h1>

            <form action="{{ path('back_signalement_reopen',{uuid:signalement.uuid}) }}" id="form-reopen{% if all == '1' %}-all{% endif %}-signalement" class="fr-mb-3v fr-w-100">
                <fieldset class="fr-fieldset" id="radio-hint{% if all == '1' %}-all{% endif %}" aria-labelledby="radio-hint-legend{% if all == '1' %}-all{% endif %} radio-hint-messages">
                    <legend class="fr-fieldset__legend--regular fr-fieldset__legend" id="radio-hint-legend{% if all == '1' %}-all{% endif %}">
                        Un suivi de ré-ouverture va être créé.
                        <br>
                        Souhaitez-vous qu'il soit partagé à l'usager ?
                    </legend>
                    <div class="fr-fieldset__element">
                        <div class="fr-radio-group">
                            <input type="radio" id="publicSuiviReopen-1{% if all == '1' %}-all{% endif %}" name="publicSuivi" value="1" checked>
                            <label class="fr-label" for="publicSuiviReopen-1{% if all == '1' %}-all{% endif %}">
                                Oui
                            </label>
                        </div>
                    </div>
                    <div class="fr-fieldset__element">
                        <div class="fr-radio-group">
                            <input type="radio" id="publicSuiviReopen-2{% if all == '1' %}-all{% endif %}" name="publicSuivi" value="0">
                            <label class="fr-label" for="publicSuiviReopen-2{% if all == '1' %}-all{% endif %}">
                                Non
                            </label>
                        </div>
                    </div>
                </fieldset>
                <input type="hidden" name="_token" value="{{ csrf_token('signalement_reopen_'~signalement.id) }}">
            </form>
        </div>
        <div class="side-panel__footer">
            <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-sm fr-btns-group--icon-left">
                <li>
                    <button type="submit"
                        class="fr-btn fr-btn--icon-left fr-icon-check-line reopen"
                        form="form-reopen{% if all == '1' %}-all{% endif %}-signalement"
                        name="signalement-action[{% if all == '1' %}reopenAll{% else %}reopen{% endif %}]"
                        value="1"
                        >{% if all == '1' %}
                            Rouvrir le signalement pour tous
                        {% else %}
                            Rouvrir pour {{ app.user.partnerInTerritoryOrFirstOne(signalement.territory) ? app.user.partnerInTerritoryOrFirstOne(signalement.territory).nom : 'N/A' }}
                        {% endif %}</button>
                </li>
                <li>
                    <button type="button"
                        class="fr-btn fr-btn--secondary fr-icon-close-line js-close-panel"
                        data-panel="panel-reopen{% if all == '1' %}-all{% endif %}-signalement"
                        aria-controls="panel-reopen{% if all == '1' %}-all{% endif %}-signalement"
                        aria-expanded="false"
                        >Annuler</button>
                </li>
            </ul>
        </div>
    </div>
</dialog>