<dialog aria-labelledby="panel-edit-file-title" id="panel-edit-file" class="side-panel">
    <div class="side-panel__inner">
        <div class="side-panel__header">
            <button type="button" class="fr-btn--close fr-btn js-close-panel" data-panel="panel-edit-file" aria-controls="panel-edit-file" aria-expanded="false">Fermer</button>
        </div>
        <div class="side-panel__content fr-mx-3w">
            <h1 id="panel-edit-file-title" class="fr-modal__title title-blue-france">Editer le document</h1>

            <form method="POST" name="form-edit-file" id="form-edit-file" enctype="application/json"
                action="{{ path('back_signalement_edit_file',{uuid:signalement.uuid}) }}"
                data-submit-type="formData"
                >

                <div class="fr-text--center fr-grid-row fr-grid-row--center">
                    <div id="fr-modal-edit-file-miniature" class="fr-col-12 fr-rounded signalement-file-item fr-mb-1w"></div>
                    <div class="fr-col-12 fr-mb-2w">
                        <b><span class="fr-modal-file-edit-filename"></span></b>
                        <br>
                        <span class="fr-modal-file-edit-infos"></span>             
                    </div>          
                </div> 

                <div class="fr-input-group">
                    <span class="no-field-errors"></span>
                </div>

                <div class="fr-select-group">
                    <label class="fr-label" for="document-type-select">Type de document</label>
                    <select class="fr-select" name="documentType" id="document-type-select"></select>
                </div>                            

                <div id="fr-modal-edit-file-description" class="fr-input-group fr-hidden fr-col-12  fr-mb-2w">
                    <label class="fr-label" for="fileDescription">Description (250 caractères maximum - facultatif) :</label>
                    <textarea class="fr-input" type="text" id="fileDescription" name="description" maxlength="250">
                    </textarea>
                </div>  

                <input type="hidden" name="_token" value="{{ csrf_token('signalement_edit_file_'~signalement.id) }}">
                <input type="hidden" name="file_id" id="file-edit-fileid">
                <input type="hidden" name="from" value="edit">
            </form>
        </div>
        <div class="side-panel__footer">
            <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-sm fr-btns-group--icon-left">
                <li>
                    <button type="submit" class="fr-btn fr-btn--icon-left fr-icon-check-line" type="button" form="form-edit-file"
                        >Valider</button>
                </li>
                <li>
                    <button class="fr-btn fr-btn--secondary fr-icon-close-line js-close-panel" data-panel="panel-edit-file" aria-controls="panel-edit-file" aria-expanded="false" type="button"
                        >Annuler</button>
                </li>
            </ul>
        </div>
    </div>
</dialog>