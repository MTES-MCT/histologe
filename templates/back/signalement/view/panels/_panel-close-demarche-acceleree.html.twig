<dialog aria-labelledby="panel-close-demarche-acceleree-title" id="panel-close-demarche-acceleree" data-panel-visite="true" class="side-panel">
    <div class="side-panel__inner">
        <div class="side-panel__header">
            <button type="button" class="fr-btn--close fr-btn js-close-panel" data-panel="panel-close-demarche-acceleree" aria-controls="panel-close-demarche-acceleree" aria-expanded="false">Fermer</button>
        </div>

        <div class="side-panel__content fr-mx-3w">
            <h1 id="panel-close-demarche-acceleree-title" class="fr-modal__title title-blue-france"
                >Clôturer la démarche accélérée #{{ signalement.reference }}</h1>

            {{ form_start(adminCancelInjonctionProcedureForm, {'attr': {'id': 'form-close-demarche-acceleree', 'data-submit-type': 'formData'}}) }}
            {{ form_errors(adminCancelInjonctionProcedureForm) }}
                <div class="fr-my-3w">
                    <p>
                        Expliquez pourquoi vous souhaitez arrêter la procédure.<br>
                        Tous les champs sont obligatoires.
                    </p>
                    
                    <div class="fr-mb-2w">
                        {{ form_widget(adminCancelInjonctionProcedureForm.reason, {display_mode: 'block-borders'}) }}
                    </div>

                    {{ form_row(adminCancelInjonctionProcedureForm.details,{}) }}
                </div>	
            {{ form_end(adminCancelInjonctionProcedureForm) }}
        </div>
        <div class="side-panel__footer">
            <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-sm fr-btns-group--icon-left">
                <li>
                    <button type="submit"
                        class="fr-btn fr-btn--icon-left fr-icon-check-line"
                        form="form-close-demarche-acceleree"
                        >Valider</button>
                </li>
                <li>
                    <button type="button"
                        class="fr-btn fr-btn--secondary fr-icon-close-line js-close-panel"
                        data-panel="panel-close-demarche-acceleree"
                        aria-controls="panel-close-demarche-acceleree"
                        aria-expanded="false"
                        >Annuler</button>
                </li>
            </ul>
        </div>
    </div>
</dialog>