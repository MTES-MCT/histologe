<dialog
        aria-labelledby="container-pick-localisation-title"
        id="container-pick-localisation"
        class="side-panel"
        data-address="{{ signalement is defined and signalement ? signalement.address.housenumberAndStreet : '' }}"
        data-postcode="{{ signalement is defined and signalement ? signalement.address.postCode : '' }}"
        {% if requireAddress is defined and requireAddress %}data-require-address="true"{% endif %}
        data-loaded="false"
>
    <div class="side-panel__inner">
        <div class="side-panel__header">
            <button type="button" class="fr-btn--close fr-btn js-close-panel" data-panel="container-pick-localisation" aria-controls="container-pick-localisation" aria-expanded="false">Fermer</button>
        </div>
        <div class="side-panel__content fr-mx-3w">
            <h1 id="container-pick-localisation-title" class="fr-modal__title title-blue-france">Sélectionner le bâtiment correspondant au logement</h1>
            <p>Cliquez sur un bâtiment pour le sélectionner, ou utilisez les touches fléchées puis Entrée.</p>
            <div id="container-pick-localisation-message" class="fr-hidden">Chargement en cours</div>
            <div id="container-pick-localisation-map"></div>
            {% if requireAddress is defined and requireAddress %}
                <div id="container-pick-localisation-no-address-alert" class="fr-alert fr-alert--warning fr-alert--sm fr-mt-2w fr-hidden" role="alert">
                    <p>Aucune adresse n'est associée à ce bâtiment. Veuillez sélectionner un autre bâtiment sur la carte.</p>
                </div>
                <div id="container-pick-localisation-address-info" class="fr-alert fr-alert--info fr-alert--sm fr-mt-2w fr-hidden">
                    <p><strong>Adresse associée :</strong> <span id="container-pick-localisation-selected-address"></span></p>
                </div>
            {% endif %}
            <div id="container-pick-localisation-announcement" aria-live="polite" aria-atomic="true" class="fr-sr-only"></div>
            {% if url is defined %}
                <form action="{{ url }}" method="POST" id="container-pick-localisation-form" data-submit-type="formData">
                    <input type="hidden" name="rnbId" id="container-pick-localisation-rnb-id">
                    <input type="hidden" name="_token" value="{{ csrf_token('signalement_set_rnb_' ~ (signalement is defined and signalement ? signalement.uuid : '')) }}">
                </form>
            {% else %}
                <input type="hidden" name="rnbId" id="container-pick-localisation-rnb-id">
            {% endif %}
        </div>
        <div class="side-panel__footer">
            <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-sm fr-btns-group--icon-left">
                <li>
                    <button class="fr-btn fr-btn--icon-left fr-icon-check-line" id="container-pick-localisation-submit" disabled type="{% if url is defined %}submit{% else %}button{% endif %}" {% if url is defined %}form="container-pick-localisation-form"{% endif %}>
                        Valider
                    </button>
                </li>
                <li>
                    <button type="button" class="fr-btn fr-btn--secondary fr-icon-close-line js-close-panel" data-panel="container-pick-localisation" aria-controls="container-pick-localisation" aria-expanded="false">
                        Annuler
                    </button>
                </li>
            </ul>
        </div>
    </div>
</dialog>
