<dialog aria-labelledby="panel-cancel-visite-title-{{intervention.id}}" id="panel-cancel-visite-{{intervention.id}}" class="side-panel">
    <div class="side-panel__inner">
        <div class="side-panel__header">
            <button type="button" class="fr-btn--close fr-btn js-close-panel" data-panel="panel-cancel-visite-{{intervention.id}}" aria-controls="panel-cancel-visite-{{intervention.id}}" aria-expanded="false">Fermer</button>
        </div>

        <div class="side-panel__content fr-mx-3w">
            <h1 id="panel-cancel-visite-title-{{intervention.id}}" class="fr-modal__title title-blue-france"
                >Annuler la visite du
                    {{ (intervention.scheduledAt.format('H')) > 0 ? intervention.scheduledAt|date('d/m/Y à H:i') : intervention.scheduledAt.format('d/m/Y') }}</h1>

            <form method="POST"
                id="form-cancel-visite-{{intervention.id}}"
                data-intervention-id="{{intervention.id}}"
                class="form-cancel-visite"
                enctype="multipart/form-data"
                action="{{ path('back_signalement_visite_cancel',{uuid:signalement.uuid}) }}"
                >
                <div class="fr-alert fr-alert--warning">
                    <p>
                        Un suivi d'annulation sera envoyé à l'usager.
                    </p>
                </div>

                <p class="fr-mt-2w">Tous les champs sont obligatoires.</p>

                <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--middle fr-my-3w">
                    <div class="fr-col-12">
                        <label class="fr-label fr-mb-3v" for="visite-cancel[details]">Motif de l'annulation</label>
                        <p id="signalement-cancel-visite-details-error-{{intervention.id}}" class="fr-error-text fr-hidden fr-my-3v">
                            Veuillez détailler le motif de l'annulation.
                        </p>
                        <textarea class="fr-input fr-input--no-resize editor" name="visite-cancel[details]" id="visite-cancel[details]-{{intervention.id}}" minlength="10"></textarea>
                    </div>
                </div>
                <input type="hidden" name="visite-cancel[intervention]" value="{{intervention.id}}">
                <input type="hidden" name="_token" value="{{ csrf_token('signalement_cancel_visit_'~intervention.id) }}">
            </form>
        </div>
        <div class="side-panel__footer">
            <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-sm fr-btns-group--icon-left">
                <li>
                    <button type="submit"
                        class="fr-btn fr-btn--icon-left fr-icon-check-line"
                        form="form-cancel-visite-{{intervention.id}}"
                        >Valider</button>
                </li>
                <li>
                    <button type="button"
                        class="fr-btn fr-btn--secondary fr-icon-close-line js-close-panel"
                        data-panel="panel-cancel-visite-{{intervention.id}}"
                        aria-controls="panel-cancel-visite-{{intervention.id}}"
                        aria-expanded="false"
                        >Annuler</button>
                </li>
            </ul>
        </div>
    </div>
</dialog>