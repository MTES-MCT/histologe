<dialog aria-labelledby="panel-add-visite-title" id="panel-add-visite" data-panel-visite="true" class="side-panel">
    <div class="side-panel__inner">
        <div class="side-panel__header">
            <button type="button" class="fr-btn--close fr-btn js-close-panel" data-panel="panel-add-visite" aria-controls="panel-add-visite" aria-expanded="false">Fermer</button>
        </div>

        <div class="side-panel__content fr-mx-3w">
            <h1 id="panel-add-visite-title" class="fr-modal__title title-blue-france">Définir une date de visite</h1>

            <form method="POST" id="form-add-visite" enctype="multipart/form-data" action="{{ path('back_signalement_visite_add',{uuid:signalement.uuid}) }}">
                <p>Les champs obligatoires sont suivis d'une étoile <span class="fr-text-default--error">*</span>.</p>
                {% if linkToVisitGrid %}
                    <div class="fr-my-5v fr-text--right">
                        <a class="fr-btn fr-btn--secondary fr-icon-article-line fr-btn--icon-left matomo_download" 
                            title="Télécharger la grille de visite {% if signalement.territory.grilleVisiteFilename %}du territoire{% endif %}"
                            download href="{{ sign_url(linkToVisitGrid) }}"
                            >Grille de visite</a>
                    </div>
                {% endif %}
                {% if not signalement.isLogementVacant %}
                    <div class="fr-alert fr-alert--warning">
                        <p>
                            Si vous choisissez une <strong>date à venir</strong>,
                            un e-mail sera automatiquement envoyé à l'usager.
                        </p>
                    </div>
                {% endif %}

                <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--middle fr-my-3w">
                    <div class="fr-col-12 fr-mb-3v">
                        <div class="fr-input-group">
                            <label class="fr-label" for="visite-add-date">Date de la visite <span class="fr-text-default--error">*</span></label>
                            <input type="date"
                                id="visite-add-date"
                                class="fr-input add-fields-if-past-date"
                                data-displayfields="visite-add-past-date-complementary-fields"
                                data-hidefields="visite-add-future-date-complementary-fields"
                                name="visite-add[date]" required>
                        </div>

                        <div class="fr-input-group">
                            <label class="fr-label" for="visite-add-time">Heure de la visite</label>
                            <input type="time"
                                id="visite-add-time"
                                class="fr-input"
                                data-territory-timezone="{{ territory_timezone }}"
                                data-displayfields="visite-add-past-date-complementary-fields"
                                data-hidefields="visite-add-future-date-complementary-fields"
                                name="visite-add[time]">
                        </div>
                        
                        {% if is_granted('ROLE_ADMIN_TERRITORY') %}
                            <div class="fr-select-group">
                                <label class="fr-label" for="visite-add-partner">Opérateur de visite <span class="fr-text-default--error">*</span></label>
                                <select id="visite-add-partner" name="visite-add[partner]" class="fr-select visite-partner-select" required>
                                    <option value=""></option>
                                    {% for partner in partnersCanVisite %}
                                        {% set alertPartner = false %}
                                        {% for pendingVisite in pendingVisites %}
                                            {% if pendingVisite.partner is not null and pendingVisite.partner.id is same as partner.id %}
                                                {% set alertPartner = true %}
                                            {% endif %}
                                        {% endfor %}
                                        <option
                                            value="{{ partner.id }}"
                                            class="{{ alertPartner ? 'alert-partner' : '' }}"
                                            >
                                            {{ partner.nom|upper }}
                                        </option>
                                    {% endfor %}
                                    <option value="extern">Opérateur Externe</option>
                                </select>
                                <p id="signalement-add-visite-partner-double-error" class="fr-error-text fr-hidden">
                                    Ce partenaire a déjà une visite en cours.
                                    Veuillez terminer ou annuler la visite ou sélectionner un autre partenaire.
                                </p>
                            </div>
                            <div class="fr-input-group fr-hidden">
                                <label class="fr-label" for="visite-add-externalOperator">Nom de l'opérateur externe <span class="fr-text-default--error">*</span></label>
                                <input type="text" id="visite-add-externalOperator" name="visite-add[externalOperator]" maxlength="255" class="fr-input visite-external-operator">
                            </div>
                        {% else %}
                            <input type="hidden" name="visite-add[partner]" value="{{ app.user.partnerInTerritory(signalement.territory).id }}">
                        {% endif %}

                        <div class="fr-input-group" id="visite-add-future-date-complementary-fields">
                            <label class="fr-label" for="visite-add-commentBeforeVisite">
                                Commentaire (facultatif)
                                <span class="fr-hint-text">Le commentaire sera visible de l'usager</span>
                            </label>
                            <textarea class="fr-input fr-input--no-resize editor field-visite-details" id="visite-add-commentBeforeVisite" name="visite-add[commentBeforeVisite]" minlength="10"></textarea>
                        </div>

                        <div id="visite-add-past-date-complementary-fields" class="fr-hidden">
                            {% set formType = 'add' %}
                            {% include 'back/signalement/view/visites/visites-form-confirm-fields.html.twig' %}
                        </div>
                    </div>
                </div>
                <input type="hidden" name="_token" value="{{ csrf_token('signalement_add_visit_'~signalement.id) }}">
            </form>
        </div>
        <div class="side-panel__footer">
            <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-sm fr-btns-group--icon-left">
                <li>
                    <button type="submit"
                        class="fr-btn fr-btn--icon-left fr-icon-check-line"
                        form="form-add-visite"
                        >Valider</button>
                </li>
                <li>
                    <button type="button"
                        class="fr-btn fr-btn--secondary fr-icon-close-line js-close-panel"
                        data-panel="panel-add-visite"
                        aria-controls="panel-add-visite"
                        aria-expanded="false"
                        >Annuler</button>
                </li>
            </ul>
        </div>
    </div>
</dialog>