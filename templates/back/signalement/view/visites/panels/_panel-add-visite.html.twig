<dialog aria-labelledby="panel-add-visite-title" id="panel-add-visite" data-panel-visite="true" class="side-panel">
    <div class="side-panel__inner">
        <div class="side-panel__header">
            <button type="button" class="fr-btn--close fr-btn js-close-panel" data-panel="panel-add-visite" aria-controls="panel-add-visite" aria-expanded="false">Fermer</button>
        </div>

        <div class="side-panel__content fr-mx-3w">
            <h1 id="panel-add-visite-title" class="fr-modal__title title-blue-france">Définir une visite</h1>
            <p>Les champs obligatoires sont suivis d'une étoile <span class="fr-text-default--error">*</span>.</p>
            <div class="fr-mb-6v">
                {% if linkToVisitGrid %}
                    <div class="fr-my-5v fr-text--right">
                        <a class="fr-btn fr-btn--secondary fr-icon-article-line fr-btn--icon-left matomo_download" 
                            title="Télécharger la grille de visite {% if signalement.address.territory.grilleVisiteFilename %}du territoire{% endif %}"
                            download href="{{ sign_url(linkToVisitGrid) }}"
                            >Grille de visite</a>
                    </div>
                {% endif %}
                {% if not signalement.isLogementVacant %}
                    <div class="fr-alert fr-alert--warning">
                        <p>
                            Si vous choisissez une <strong>date à venir</strong>,
                            un e-mail sera automatiquement envoyé à l'usager.
                        </p>
                    </div>
                {% endif %}
            </div>
            {{ form_start(addVisiteForm, {'attr': {'id': 'add-visite-form', 'data-submit-type':'formData'}}) }}
                {{ form_errors(addVisiteForm) }}

                {{ form_row(addVisiteForm.scheduledAt) }}
                {{ form_row(addVisiteForm.scheduledAtTime) }}
                {% if is_granted('ROLE_ADMIN_TERRITORY') %}
                    <div class="fr-select-group {% if addVisiteForm.partnerChoice.vars.errors|length > 0 %}fr-select-group--error{% endif %}">
                        {{ form_label(addVisiteForm.partnerChoice) }}
                        {{ form_widget(addVisiteForm.partnerChoice) }}
                        {{ form_errors(addVisiteForm.partnerChoice) }}
                        <p class="fr-error-text static-error fr-hidden signalement-add-visite-partner-double-error">
                            Ce partenaire a déjà une visite en cours.
                            Veuillez terminer ou annuler la visite ou sélectionner un autre partenaire.
                        </p>
                    </div>
                    {{ form_row(addVisiteForm.externalOperator) }}
                {% endif %}
                <div class="visite-add-future-date-complementary-fields">
                {{ form_row(addVisiteForm.commentBeforeVisite) }}
                </div>
                <div class="visite-add-past-date-complementary-fields fr-hidden">
                    {{ form_row(addVisiteForm.visiteDone) }}
                    {{ form_row(addVisiteForm.occupantPresent) }}
                    {{ form_row(addVisiteForm.proprietairePresent) }}
                    <div class="visite-conclude-procedure fr-mb-6v fr-hidden">
                        {{ form_row(addVisiteForm.concludeProcedure)}}
                    </div>
                    {{ form_row(addVisiteForm.notifyUsager) }}
                    {{ form_row(addVisiteForm.details) }}
                    {{ form_row(addVisiteForm.rapportDeVisite) }}
                    {% if not s3_enable %}
                        <div class="fr-alert fr-alert--warning fr-mb-2w">
                            <h3 class="fr-alert__title">Maintenance en cours</h3>
                            <p>L'accès aux documents et photos est temporairement désactivé pour maintenance.</p>
                        </div>
                    {% endif %}
                </div>

            {{ form_end(addVisiteForm) }}
        </div>
        <div class="side-panel__footer">
            <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-sm fr-btns-group--icon-left">
                <li>
                    <button type="submit"
                        class="fr-btn fr-btn--icon-left fr-icon-check-line"
                        form="add-visite-form"
                        >Valider</button>
                </li>
                <li>
                    <button type="button"
                        class="fr-btn fr-btn--secondary fr-icon-close-line js-close-panel"
                        data-panel="panel-add-visite"
                        aria-controls="panel-add-visite"
                        aria-expanded="false"
                        >Annuler</button>
                </li>
            </ul>
        </div>
    </div>
</dialog>