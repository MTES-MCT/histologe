<dialog aria-labelledby="panel-confirm-visite-title-{{intervention.id}}" id="panel-confirm-visite-{{intervention.id}}" data-panel-visite="true" class="side-panel">
    <div class="side-panel__inner">
        <div class="side-panel__header">
            <button type="button" class="fr-btn--close fr-btn js-close-panel" data-panel="panel-confirm-visite-{{intervention.id}}" aria-controls="panel-confirm-visite-{{intervention.id}}" aria-expanded="false">Fermer</button>
        </div>

        <div class="side-panel__content fr-mx-3w">
            <h1 id="panel-confirm-visite-title-{{intervention.id}}" class="fr-modal__title title-blue-france"
                >Conclusion de la visite du 
                    {{ (intervention.scheduledAt.format('H')) > 0 ? intervention.scheduledAt|date('d/m/Y à H:i') : intervention.scheduledAt.format('d/m/Y') }}</h1>

            <form method="POST"
                id="form-confirm-visite-{{intervention.id}}"
                data-intervention-id="{{intervention.id}}"
                class="form-confirm-visite"
                enctype="multipart/form-data"
                action="{{ path('back_signalement_visite_confirm',{uuid:signalement.uuid}) }}"
                >
                <div class="fr-alert fr-alert--info">
                    <p>
                        La conclusion et le commentaire seront partagés à l'usager.
                    </p>
                </div>

                <p class="fr-mt-3v">Les champs obligatoires sont suivis d'une étoile <span class="fr-text-default--error">*</span>.</p>

                <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--middle fr-my-3w">
                    <div class="fr-col-12 fr-mb-3v">
                        {% set formType = 'confirm' %}
                        {% include 'back/signalement/view/visites/visites-form-confirm-fields.html.twig' %}
                    </div>
                </div>
                <input type="hidden" name="visite-confirm[intervention]" value="{{intervention.id}}">
                <input type="hidden" name="_token" value="{{ csrf_token('signalement_confirm_visit_'~intervention.id) }}">
            </form>
        </div>
        <div class="side-panel__footer">
            <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-sm fr-btns-group--icon-left">
                <li>
                    <button type="submit"
                        class="fr-btn fr-btn--icon-left fr-icon-check-line"
                        form="form-confirm-visite-{{intervention.id}}"
                        >Valider</button>
                </li>
                <li>
                    <button type="button"
                        class="fr-btn fr-btn--secondary fr-icon-close-line js-close-panel"
                        data-panel="panel-confirm-visite-{{intervention.id}}"
                        aria-controls="panel-confirm-visite-{{intervention.id}}"
                        aria-expanded="false"
                        >Annuler</button>
                </li>
            </ul>
        </div>
    </div>
</dialog>