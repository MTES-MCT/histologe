<dialog aria-labelledby="panel-manage-visite-title" id="panel-manage-visite" data-panel-visite="true" class="side-panel">
    <div class="side-panel__inner">
        <div class="side-panel__header">
            <button type="button" class="fr-btn--close fr-btn js-close-panel" data-panel="panel-manage-visite" aria-controls="panel-manage-visite" aria-expanded="false">Fermer</button>
        </div>

        <div class="side-panel__content fr-mx-3w">
            <h1 id="panel-manage-visite-title" class="fr-modal__title title-blue-france">
                Chargement en cours...    
            </h1>
            <div id="panel-manage-visite-content">Chargement en cours...</div>
        </div>
        <div class="side-panel__footer">
            <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-sm fr-btns-group--icon-left">
                <li>
                    <button type="submit" class="fr-btn fr-btn--icon-left fr-icon-check-line" form="#">Valider</button>
                </li>
                <li>
                    <button type="button"
                        class="fr-btn fr-btn--secondary fr-icon-close-line js-close-panel"
                        data-panel="panel-manage-visite"
                        aria-controls="panel-manage-visite"
                        aria-expanded="false"
                        >Annuler</button>
                </li>
            </ul>
        </div>
    </div>
</dialog>