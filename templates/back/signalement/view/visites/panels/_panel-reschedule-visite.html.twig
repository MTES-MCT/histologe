<dialog aria-labelledby="panel-reschedule-visite-title-{{intervention.id}}" id="panel-reschedule-visite-{{intervention.id}}" data-panel-visite="true" class="side-panel">
    <div class="side-panel__inner">
        <div class="side-panel__header">
            <button type="button" class="fr-btn--close fr-btn js-close-panel" data-panel="panel-reschedule-visite-{{intervention.id}}" aria-controls="panel-reschedule-visite-{{intervention.id}}" aria-expanded="false">Fermer</button>
        </div>

        <div class="side-panel__content fr-mx-3w">
            <h1 id="panel-reschedule-visite-title-{{intervention.id}}" class="fr-modal__title title-blue-france"
                >Modifier la visite du
                    {{ (intervention.scheduledAt.format('H')) > 0 ? intervention.scheduledAt|date('d/m/Y à H:i') : intervention.scheduledAt.format('d/m/Y') }}</h1>

            <form method="POST"
                id="form-reschedule-visite-{{intervention.id}}"
                data-intervention-id="{{intervention.id}}"
                class="form-reschedule-visite"
                enctype="multipart/form-data"
                action="{{ path('back_signalement_visite_reschedule',{uuid:signalement.uuid}) }}"
                >
                <div class="fr-alert fr-alert--info">
                    <p>
                        {% if not signalement.isLogementVacant %}
                            Si vous choisissez une date future, un suivi de modification de date sera envoyé à l'usager.
                            <br>
                        {% endif %}
                        Si vous choisissez une date passée, vous pourrez saisir les conclusions de la visite.
                    </p>
                </div>

                <p class="fr-mt-3v">Les champs obligatoires sont suivis d'une étoile <span class="fr-text-default--error">*</span>.</p>

                <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--middle fr-my-3w">
                    <div class="fr-col-12 fr-mb-3v">
                        <div class="fr-input-group">
                            <label class="fr-label" for="visite-reschedule-date-{{intervention.id}}">Date de la visite <span class="fr-text-default--error">*</span></label>
                            <input type="date"
                                id="visite-reschedule-date-{{intervention.id}}"
                                class="fr-input add-fields-if-past-date"
                                data-displayfields="visite-reschedule-{{intervention.id}}-past-date-complementary-fields"
                                data-hidefields="visite-reschedule-{{intervention.id}}-future-date-complementary-fields"
                                name="visite-reschedule[date]"
                                value="{{ intervention.scheduledAt.format('Y-m-d') }}"
                                required>
                        </div>

                        <div class="fr-input-group">
                            <label class="fr-label" for="visite-reschedule-time-{{intervention.id}}">Heure de la visite</label>
                            <input type="time"
                                id="visite-reschedule-time-{{intervention.id}}"
                                class="fr-input"
                                data-displayfields="visite-reschedule-{{intervention.id}}-past-date-complementary-fields"
                                data-hidefields="visite-reschedule-{{intervention.id}}-future-date-complementary-fields"
                                name="visite-reschedule[time]"
                                value="{{ (intervention.scheduledAt.format('H')) > 0 ? intervention.scheduledAt|date('H:i')  : '' }}">
                        </div>
                        
                        {% if is_granted('ROLE_ADMIN_TERRITORY') %}
                            <div class="fr-select-group">
                                <label class="fr-label" for="visite-reschedule-partner-{{intervention.id}}">Opérateur de visite <span class="fr-text-default--error">*</span></label>
                                <select id="visite-reschedule-partner-{{intervention.id}}" name="visite-reschedule[partner]" class="fr-select visite-partner-select">
                                    {% for partner in partnersCanVisite %}
                                        {% set alertPartner = false %}
                                        {% for pendingVisite in pendingVisites %}
                                            {% if intervention.partner is not null
                                                and pendingVisite.partner is not null
                                                and pendingVisite.partner.id is same as partner.id
                                                and partner.id is not same as intervention.partner.id %}
                                                {% set alertPartner = true %}
                                            {% endif %}
                                        {% endfor %}
                                        <option
                                            value="{{ partner.id }}"
                                            {% if intervention.partner is not null
                                                and partner.id is same as intervention.partner.id %}selected="selected"{% endif %}
                                            class="{{ alertPartner ? 'alert-partner' : '' }}"
                                            >
                                            {{ partner.nom|upper }}
                                        </option>
                                    {% endfor %}
                                    <option value="extern" {% if intervention.partner is null or intervention.partner.id is null %}selected="selected"{% endif %}>Opérateur Externe</option>
                                </select>
                                <p id="signalement-reschedule-visite-partner-double-error" class="fr-error-text fr-hidden fr-my-3v">
                                    Ce partenaire a déjà une visite en cours.
                                    Veuillez terminer ou annuler la visite ou sélectionner un autre partenaire.
                                </p>
                            </div>
                            <div class="fr-input-group fr-hidden" id="visite-reschedule-external-operator">
                                <label class="fr-label" for="visite-reschedule-external-operator-{{intervention.id}}">Nom de l'opérateur externe <span class="fr-text-default--error">*</span></label>
                                <input type="text" id="visite-reschedule-external-operator-{{intervention.id}}" name="visite-reschedule[externalOperator]" value="{{intervention.externalOperator}}" maxlength="255" class="fr-input visite-external-operator">
                            </div>
                        {% else %}
                            <input type="hidden" name="visite-reschedule[partner]" value="{{ app.user.partnerInTerritory(signalement.territory).id }}">
                        {% endif %}

                        <div class="fr-input-group" id="visite-reschedule-{{intervention.id}}-future-date-complementary-fields">
                            <label class="fr-label" for="visite-reschedule-commentBeforeVisite-{{intervention.id}}">
                                Commentaire (facultatif)
                                <span class="fr-hint-text">Le commentaire sera visible de l'usager</span>
                            </label>
                            <textarea class="fr-input fr-input--no-resize editor field-visite-details" id="visite-reschedule-commentBeforeVisite-{{intervention.id}}" name="visite-reschedule[commentBeforeVisite]" minlength="10">{{
                                intervention is defined and intervention.commentBeforeVisite ? intervention.commentBeforeVisite : ''
                            }}</textarea>
                        </div>

                        <div id="visite-reschedule-{{intervention.id}}-past-date-complementary-fields" class="fr-hidden">
                            {% set formType = 'reschedule' %}
                            {% include 'back/signalement/view/visites/visites-form-confirm-fields.html.twig' %}
                        </div>
                    </div>
                </div>
                <input type="hidden" name="visite-reschedule[intervention]" value="{{intervention.id}}">
                <input type="hidden" name="_token" value="{{ csrf_token('signalement_reschedule_visit_'~intervention.id) }}">
            </form>
        </div>
        <div class="side-panel__footer">
            <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-sm fr-btns-group--icon-left">
                <li>
                    <button type="submit"
                        class="fr-btn fr-btn--icon-left fr-icon-check-line"
                        form="form-reschedule-visite-{{intervention.id}}"
                        >Valider</button>
                </li>
                <li>
                    <button type="button"
                        class="fr-btn fr-btn--secondary fr-icon-close-line js-close-panel"
                        data-panel="panel-reschedule-visite-{{intervention.id}}"
                        aria-controls="panel-reschedule-visite-{{intervention.id}}"
                        aria-expanded="false"
                        >Annuler</button>
                </li>
            </ul>
        </div>
    </div>
</dialog>