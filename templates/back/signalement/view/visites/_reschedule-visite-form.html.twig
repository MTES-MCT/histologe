<div class="fr-alert fr-alert--info">
    <p>
        {% if not intervention.signalement.isLogementVacant %}
            Si vous choisissez une date future, un suivi de modification de date sera envoyé à l'usager.
            <br>
        {% endif %}
        Si vous choisissez une date passée, vous pourrez saisir les conclusions de la visite.
    </p>
</div>

<p class="fr-mt-3v">Les champs obligatoires sont suivis d'une étoile <span class="fr-text-default--error">*</span>.</p>

{{ form_start(rescheduleVisiteForm, {'attr': {'id': 'reschedule-visite-form', 'data-submit-type':'formData'}}) }}
    {{ form_errors(rescheduleVisiteForm) }}

    {{ form_row(rescheduleVisiteForm.scheduledAt) }}
    {{ form_row(rescheduleVisiteForm.scheduledAtTime) }}
    {% if is_granted('ROLE_ADMIN_TERRITORY') %}
        <div class="fr-select-group {% if rescheduleVisiteForm.partnerChoice.vars.errors|length > 0 %}fr-select-group--error{% endif %}">
            {{ form_label(rescheduleVisiteForm.partnerChoice) }}
            {{ form_widget(rescheduleVisiteForm.partnerChoice) }}
            {{ form_errors(rescheduleVisiteForm.partnerChoice) }}
            <p class="fr-error-text static-error fr-hidden signalement-visite-partner-double-error">
                Ce partenaire a déjà une visite en cours.
                Veuillez terminer ou annuler la visite ou sélectionner un autre partenaire.
            </p>
        </div>
        {{ form_row(rescheduleVisiteForm.externalOperator) }}
    {% endif %}
    <div class="visite-future-date-complementary-fields">
    {{ form_row(rescheduleVisiteForm.commentBeforeVisite) }}
    </div>
    <div class="visite-past-date-complementary-fields fr-hidden">
        {{ form_row(rescheduleVisiteForm.visiteDone) }}
        {{ form_row(rescheduleVisiteForm.occupantPresent) }}
        {{ form_row(rescheduleVisiteForm.proprietairePresent) }}
        <div class="visite-conclude-procedure fr-mb-6v fr-hidden">
            {{ form_row(rescheduleVisiteForm.concludeProcedure)}}
        </div>
        {{ form_row(rescheduleVisiteForm.notifyUsager) }}
        {{ form_row(rescheduleVisiteForm.details) }}
        {% if rescheduleVisiteForm.rapportDeVisite is defined %}
            {{ form_row(rescheduleVisiteForm.rapportDeVisite) }}
            {% if not s3_enable %}
                <div class="fr-alert fr-alert--warning fr-mb-2w">
                    <h3 class="fr-alert__title">Maintenance en cours</h3>
                    <p>L'accès aux documents et photos est temporairement désactivé pour maintenance.</p>
                </div>
            {% endif %}
        {% else %}
            {% if s3_enable %}
                <fieldset class="fr-fieldset fr-fieldset--inline fr-mb-5v">
                    <ul class="fr-btns-group fr-btns-group--inline-sm fr-btns-group--sm">
                        <li>
                            <a href="{{ sign_url(path('show_file', {uuid: intervention.rapportDeVisite.uuid})) }}" class="fr-btn" title="Afficher le document" rel="noopener" target="_blank">Voir le rapport de visite
                            </a>
                        </li>
                        <li>
                            <a href="{{ path('back_signalement_visite_deleterapport',{intervention:intervention.id}) }}?_token={{ csrf_token('delete_rapport') }}" title="Supprimer le rapport" class="fr-btn fr-btn--secondary fr-background--white fr-fi-delete-line  simple-ajax-link"></a>
                        </li>
                    </ul>
                </fieldset>
            {% else %}
                <div class="fr-alert fr-alert--warning fr-mb-2w">
                    <h3 class="fr-alert__title">Maintenance en cours</h3>
                    <p>La consultation de documents est temporairement désactivée pour maintenance.</p>
                </div>
            {% endif %}
        {% endif %}
    </div>

{{ form_end(rescheduleVisiteForm) }}