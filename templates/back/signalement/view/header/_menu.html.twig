<nav class="fr-translate menu-actions-signalement fr-nav fr-mb-1w">
    <div class="fr-nav__item">
        <button aria-controls="header-menu" aria-expanded="false" type="button" class="fr-btn fr-btn--icon-left fr-btn--tertiary  fr-btn--icon-right fr-icon-arrow-down-s-line">
            Actions
        </button>
        <div class="fr-collapse fr-translate__menu fr-menu" id="header-menu">
            <ul class="fr-menu__list">
                {% set currentPartner =  app.user.partnerInTerritoryOrFirstOne(signalement.territory) %}
                {% set isAloneInCurrentPartner = app.user.isAloneInPartner(currentPartner) %}
                {% if is_granted('AFFECTATION_CANCEL_REFUSED', affectation) %}
                    <li>
                        {% if isAloneInCurrentPartner %}
                            <form id="signalement-affectation-response-form" action="{{ path('back_signalement_affectation_accept',{affectation:affectation.id}) }}" method="POST" class="inline-form">
                                <button class="fr-nav__link fr-btn--icon-left fr-icon-checkbox-circle-fill">
                                    Annuler le refus de l'affectation
                                </button>
                                <input type="hidden" name="_token" value="{{ csrf_token('signalement_affectation_response_'~signalement.id) }}">
                            </form>
                        {% else %}
                            <button type="button"
                                class="fr-nav__link fr-btn--icon-left fr-icon-checkbox-circle-fill"
                                aria-controls="panel-accept-affectation"
                                data-panel-open="panel-accept-affectation"
                                data-fr-opened="false"
                                >Annuler le refus de l'affectation</button>
                        {% endif %}
                    </li>
                {% elseif is_granted('SIGN_REOPEN', signalement) %}
                    <li>
                        <button
                            class="fr-nav__link fr-btn--icon-left fr-fi-lock-fill"
                            data-panel-open="panel-reopen-all-signalement"
                            aria-controls="panel-reopen-all-signalement" 
                            data-fr-opened="false"
                            >Rouvrir pour tous</button>
                    </li>
                {% elseif is_granted('AFFECTATION_REOPEN', affectation) %}
                    <li>
                        <button
                            class="fr-nav__link fr-btn--icon-left fr-fi-lock-fill"
                            data-panel-open="panel-reopen-signalement"
                            aria-controls="panel-reopen-signalement" 
                            data-fr-opened="false"
                            >Rouvrir pour {{ currentPartner ? currentPartner.nom : 'N/A' }}</button>
                    </li>
                {% endif %}
                {% if feature_cloture_v2 %}
                    {% if is_granted('SIGN_CLOSE', signalement) %}
                        <li>
                            <button id="test-bouton-cloturer" class="fr-nav__link fr-btn--icon-left fr-icon-close-line" data-panel-open="panel-close-signalement" aria-controls="panel-close-signalement" aria-expanded="false">
                                Fermer le dossier
                            </button>
                        </li>
                    {% endif %}
                    {% if affectation and is_granted('AFFECTATION_CLOSE', affectation) %}
                        <li>
                            <button id="link-bouton-cloturer" class="fr-nav__link fr-btn--icon-left fr-icon-close-line" data-panel-open="panel-close-affectation" aria-controls="panel-close-affectation" aria-expanded="false">
                                {% if is_granted('ROLE_ADMIN_TERRITORY') %}
                                    Fermer l'affectation
                                {% else %}
                                    Fermer le dossier
                                {% endif %}
                            </button>
                        </li>
                    {% endif %}
                {% else %}
                    {% if is_granted('SIGN_CLOSE', signalement) %}
                        <li>
                            <button
                                id="test-bouton-cloturer" 
                                class="fr-nav__link fr-btn--icon-left fr-icon-close-line"
                                aria-controls="cloture-modal" 
                                data-fr-opened="false">
                                Clôturer
                            </button>
                        </li>
                    {% elseif affectation and is_granted('AFFECTATION_CLOSE', affectation) %}
                            <li>
                                <button
                                    id="link-bouton-cloturer"
                                    class="fr-nav__link fr-btn--icon-left fr-icon-close-line"
                                    aria-controls="cloture-modal" 
                                    data-fr-opened="false">
                                    Clôturer
                                </button>
                            </li>
                    {% endif %}
                {% endif %}
                {% if is_granted('SIGN_INJONCTION_CLOSE', signalement) %}
                    <li>
                        <button
                            class="fr-nav__link fr-btn--icon-left fr-icon-close-line"
                            data-fr-opened="false"
                            data-panel-open="panel-close-demarche-acceleree"
                            aria-controls="panel-close-demarche-acceleree"
                            data-fr-opened="false"
                            >Clôturer la démarche accélérée</button>
                    </li>
                {% endif %}
                {% if is_granted('SIGN_VIEW', signalement) %}
                    <li>
                        <a {% if s3_enable %}href="{{ path('back_signalement_gen_pdf',{uuid:signalement.uuid}) }}"{% endif %}
                            class="fr-nav__link fr-btn--icon-left {% if s3_enable %}fr-icon-file-download-line simple-ajax-link{% else %}fr-icon-warning-fill disabled{% endif %}"
                            title="{% if s3_enable %}Télécharger le PDF{% else %}Maintenance en cours{% endif %}"
                            {% if not s3_enable %}aria-disabled="true" disabled{% endif %}>
                            Télécharger le PDF
                        </a>
                    </li>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    <li>
                        <button
                            class="fr-nav__link fr-btn--icon-left fr-icon-send-plane-fill"
                            data-panel-open="panel-send-lien-suivi"
                            aria-controls="panel-send-lien-suivi"
                            data-fr-opened="false"
                            title="Envoyer le lien de suivi">
                            Envoyer le lien de suivi
                        </button>
                    </li>
                    {% if 
                        signalement.statut is same as enum('App\\Entity\\Enum\\SignalementStatus').INJONCTION_BAILLEUR and 
                        signalement.mailProprio is not null and
                        signalement.suiviReponseBailleur is null %}
                        <li>
                            <a href="{{ path('send_mail_injonction_bailleur',{uuid:signalement.uuid}) }}"
                                class="fr-nav__link fr-btn--icon-left fr-icon-send-plane-line"
                                title="Envoyer le mail au bailleur">
                                Envoyer le mail au bailleur
                            </a>
                        </li>
                    {% endif %}
                    <li>
                        <a href="{{ path('back_history_entry_diff', {entity_id: signalement.id, entity_name: 'Signalement'}) }}"
                            class="fr-nav__link fr-btn--icon-left fr-icon-stack-line"
                            title="Voir l'historique des modifications">
                            Historique des modifications
                        </a>
                    </li>
                {% endif %}
                {% if is_granted('SIGN_SUBSCRIBE', signalement) %}
                    {% if isUserSubscribed %}
                            <li>
                                {% if isAloneInCurrentPartner and affectation %}
                                    <button 
                                        class="fr-nav__link fr-btn--icon-left fr-icon-eye-off-line disabled"
                                        aria-disabled="true" tabindex="-1" title="Vous ne pouvez pas quitter le dossier, étant le seul agent de votre partenaire."
                                        >Se retirer du dossier</button>
                                {% elseif subscriptionsInMyPartner|length > 1 or not affectation %}
                                    <a href="{{ path('back_signalement_unsubscribe', {uuid: signalement.uuid}) }}?_token={{ csrf_token('unsubscribe') }}"
                                        class="fr-nav__link fr-btn--icon-left fr-icon-eye-off-line"
                                        >Se retirer du dossier</a>
                                {% else %}
                                    <button
                                        class="fr-nav__link fr-btn--icon-left fr-icon-eye-off-line"
                                        data-panel-open="panel-transfer-subscription"
                                        aria-controls="panel-transfer-subscription"
                                        data-fr-opened="false"
                                        >Se retirer du dossier</button>
                                {% endif %}
                                    <button
                                        class="fr-nav__link fr-btn--icon-left fr-icon-user-add-line"
                                        data-panel-open="panel-agents-subscription" 
                                        aria-controls="panel-agents-subscription" 
                                        data-fr-opened="false"
                                        >Abonner un agent</button>
                            </li>
                        {% elseif not is_granted('AFFECTATION_CANCEL_REFUSED', affectation) %}
                            <li>
                                <a href="{{ path('back_signalement_subscribe', {uuid: signalement.uuid}) }}?_token={{ csrf_token('subscribe') }}"
                                    class="fr-nav__link fr-btn--icon-left fr-icon-eye-line">
                                    Rejoindre le dossier
                                </a>
                            </li>
                    {% endif %}
                {% endif %}
            </ul>
        </div>
    </div>
</nav>
