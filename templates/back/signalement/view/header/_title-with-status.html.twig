<div class="fr-display-inline-flex fr-align-items-center">
    <div id="signalement-title-container">
        {% include 'back/signalement/view/header/_title.html.twig' %}
    </div>
    <div class="fr-ml-3v fr-mb-5v">
        {% if is_granted('ROLE_ADMIN_TERRITORY') %}
            {% if signalement.statut is same as enum('App\\Entity\\Enum\\SignalementStatus').NEED_VALIDATION %}
                <span class="fr-badge fr-badge--warning fr-badge--no-icon">Nouveau</span>
            {% elseif signalement.statut is same as enum('App\\Entity\\Enum\\SignalementStatus').ACTIVE %}
                <span class="fr-badge fr-badge--success fr-badge--no-icon">En cours</span>
            {% elseif signalement.statut is same as enum('App\\Entity\\Enum\\SignalementStatus').REFUSED %}
                <span class="fr-badge fr-badge--new fr-badge--no-icon">Refusé</span>
            {% elseif signalement.statut is same as enum('App\\Entity\\Enum\\SignalementStatus').CLOSED %}
                <span class="fr-badge fr-badge--error fr-badge--no-icon">Fermé</span>
            {% elseif signalement.statut is same as enum('App\\Entity\\Enum\\SignalementStatus').ARCHIVED %} <!-- NE DOIT PAS ARRIVER -->
                <span class="fr-badge fr-badge--error fr-badge--no-icon">Archivé</span>
            {% elseif signalement.statut is same as enum('App\\Entity\\Enum\\SignalementStatus').DRAFT %} <!-- NE DOIT PAS ARRIVER -->
                <span class="fr-badge fr-badge--error fr-badge--no-icon">Brouillon</span>
            {% endif %}
        {% else %}
            {% if signalement.statut is same as enum('App\\Entity\\Enum\\SignalementStatus').CLOSED or affectation.statut is same as enum('App\\Entity\\Enum\\AffectationStatus').CLOSED %}
                <span class="fr-badge fr-badge--error fr-badge--no-icon">Clôturé</span>
            {% elseif affectation.statut is same as enum('App\\Entity\\Enum\\AffectationStatus').WAIT %}
                <span class="fr-badge fr-badge--warning fr-badge--no-icon">Nouveau</span>
            {% elseif affectation.statut is same as enum('App\\Entity\\Enum\\AffectationStatus').ACCEPTED %}
                <span class="fr-badge fr-badge--success fr-badge--no-icon">En cours</span>
            {% elseif affectation.statut is same as enum('App\\Entity\\Enum\\AffectationStatus').REFUSED %}
                <span class="fr-badge fr-badge--new fr-badge--no-icon">Refusé</span>
            {% endif %}
        {% endif %}
    </div>
</div>