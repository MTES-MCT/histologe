<div class="fr-mt-4v fr-p-4v fr-background-alt--grey">
    <strong>Etiquettes</strong>
    {% if is_granted('SIGN_EDIT_ACTIVE', signalement) or is_granted('SIGN_EDIT_CLOSED', signalement) %}
        <button class="fr-btn--icon-left fr-a-edit fr-icon-bookmark-line fr-ml-2v"
            data-panel-open="panel-manage-tags"
            aria-controls="panel-manage-tags"
            data-fr-opened="false"
            >Gérer les étiquettes</button>
    {% endif %}
    <div>
        <div class="fr-my-3v">
            {% for tag in signalement.tags|sort((a, b) => a.label <=> b.label) %}
                <span class="fr-badge fr-badge--info fr-badge--no-icon fr-m-1v">{{ tag.label }}</span>
            {% else %}
                <em class="fr-text-default--warning fr-fi-close-line fr-icon--xs">
                    <small>Aucune étiquette attribuée à ce signalement.</small>
                </em>
            {% endfor %}
        </div>
    </div>
</div>