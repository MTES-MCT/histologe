{% set currentPartner =  app.user.partnerInTerritoryOrFirstOne(signalement.territory) %}
{% set isAloneInCurrentPartner = app.user.isAloneInPartner(currentPartner) %}
{% if is_granted('SIGN_SWITCH_LOGEMENT_VACANT', signalement) %}
    {% include 'back/signalement/view/panels/_panel-edit-logement-vacant.html.twig' %}
{% endif %}
{% if (is_granted('AFFECTATION_ACCEPT_OR_REFUSE', affectation) or is_granted('AFFECTATION_CANCEL_REFUSED', affectation)) and not isAloneInCurrentPartner %}
    <div data-ajax-form class="fr-display-inline">
        {% include 'back/signalement/view/panels/_panel-accept-affectation.html.twig' %}
    </div>
{% endif %}
{% if isUserSubscribed and subscriptionsInMyPartner|length < 2 and affectation %}
    <div data-ajax-form class="fr-display-inline">
        {% include 'back/signalement/view/panels/_panel-transfer-subscription.html.twig' %}
    </div>
{% endif %}
{% if is_granted('SIGN_SUBSCRIBE', signalement) and isUserSubscribed %}
    <div data-ajax-form class="fr-display-inline">
        {% include 'back/signalement/view/panels/_panel-agents-subscription.html.twig' %}
    </div>
{% endif %}
{% if is_granted('SIGN_VALIDATE', signalement) and not isUniqueRtInCurrentPartner %}
    <div data-ajax-form>
        {% include 'back/signalement/view/panels/_panel-accept-signalement.html.twig' %}
    </div>
{% endif %}
{% if signalement.statut is same as enum('App\\Entity\\Enum\\SignalementStatus').INJONCTION_BAILLEUR %}
    <div class="fr-notice fr-notice--info fr-my-4v fr-text--left">
        <div class="fr-pl-3v">
            <div class="fr-notice__body">
                <p>
                    <span class="fr-notice__title">Ce signalement est en cours de démarche accélérée.</span>
                </p>
            </div>
        </div>
    </div>
{% elseif signalement.statut is same as enum('App\\Entity\\Enum\\SignalementStatus').INJONCTION_CLOSED %}
    <div class="fr-notice fr-notice--success fr-my-4v fr-text--left">
        <div class="fr-pl-3v">
            <div class="fr-notice__body">
                <p>
                    <span class="fr-notice__title">La démarche accélérée concernant ce signalement est à présent terminée.</span>
                </p>
            </div>
        </div>
    </div>
{% endif %}
{% if is_granted('AFFECTATION_ACCEPT_OR_REFUSE', affectation) %}
    <div data-ajax-form class="fr-display-inline">
        {% include 'back/signalement/view/panels/_panel-deny-affectation.html.twig' %}
    </div>
    <div class="fr-notice fr-notice--info fr-my-4v fr-text--left">
        <div class="fr-pl-3v">
            <div class="fr-notice__body">
                <p>
                    <span class="fr-notice__title">Vous devez accepter l'affectation pour pouvoir traiter le dossier.</span>
                </p>
            </div>
        </div>
    </div>
    {% if isAloneInCurrentPartner %}
        <form id="signalement-affectation-response-form" action="{{ path('back_signalement_affectation_accept',{affectation:affectation.id}) }}" method="POST" class="inline-form">
            <button class="fr-btn fr-btn--sm fr-btn--icon-left fr-icon-checkbox-circle-fill fr-btn--success">
                Accepter l'affectation
            </button>
            <input type="hidden" name="_token" value="{{ csrf_token('signalement_affectation_response_'~signalement.id) }}">
        </form>
    {% else %}
        <button type="button"
            class="fr-btn fr-btn--sm fr-btn--icon-left fr-icon-checkbox-circle-fill fr-btn--success"
            id="open-panel-accept-affectation"
            aria-controls="panel-accept-affectation"
            data-panel-open="panel-accept-affectation"
            data-fr-opened="false"
            >Accepter l'affectation</button>
    {% endif %}
    <button type="button"
        class="fr-btn fr-btn--sm fr-btn--icon-left fr-icon-close-circle-fill fr-btn--danger"
        aria-controls="panel-deny-affectation"
        data-panel-open="panel-deny-affectation"
        data-fr-opened="false"
        >Refuser l'affectation</button>
{% elseif is_granted('SIGN_VALIDATE', signalement) %}
    <div class="fr-notice fr-notice--info fr-my-4v fr-text--left">
        <div class="fr-pl-3v">
            <div class="fr-notice__body">
                <p>
                    <span class="fr-notice__title">En tant que responsable de territoire, vous devez valider ou refuser ce signalement.</span>
                </p>
            </div>
        </div>
    </div>
    <div data-ajax-form class="fr-display-inline">
        {% include 'back/signalement/view/panels/_panel-deny-signalement.html.twig' %}
    </div>
    <div class="admin-territory-validation">
        {% if isUniqueRtInCurrentPartner %}
            <form id="signalement-validation-response-form" action="{{ path('back_signalement_accept',{uuid:signalement.uuid}) }}" class="inline-form">
                <button class="fr-btn fr-btn--sm fr-btn--icon-left fr-icon-checkbox-circle-fill fr-btn--success" name="signalement-validation-response[accept]" value="1">
                    Valider le signalement
                </button>
                <input type="hidden" name="_token" value="{{ csrf_token('signalement_validation_response_'~signalement.id) }}">
            </form>
        {% else %}
            <button type="button"
                class="fr-btn fr-btn--sm fr-btn--icon-left fr-icon-checkbox-circle-fill fr-btn--success"
                id="open-accept-signalement-panel"
                data-panel-open="panel-accept-signalement"
                aria-controls="panel-accept-signalement"
                data-fr-opened="false"
                >Valider le signalement</button>
        {% endif %}
        <button type="button" class="fr-btn fr-btn--sm fr-btn--icon-left fr-fi-close-line fr-btn--danger"
            data-panel-open="panel-deny-signalement"
            aria-controls="panel-deny-signalement"
            data-fr-opened="false"
            >Refuser le signalement</button>
    </div>
{% endif %}