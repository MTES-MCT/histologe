{% if signalement|display_signalement_info_bailleur %}
    <div class="fr-p-3w fr-frame--white fr-mb-3w">
        <div class="fr-grid-row fr-grid-row--middle fr-mb-3w">
            <img src="{{ asset('build/dsfr/artwork/pictograms/document/contract.svg') }}" aria-hidden="true" class="fr-artwork fr-mr-2w" alt="" width="48" height="48">
            <h3 class="fr-h5 title-blue-france fr-mb-0">Bailleur, agence et syndic</h3>
        </div>
        <div class="fr-grid-row">
            <div class="fr-col-12 fr-col-md-6 fr-pr-6v" id="signalement-coordonnees-bailleur-container">
                {% include 'back/signalement/view/details/coordonnees-bailleur.html.twig' %}
            </div>

            <div class="fr-col-12 fr-col-md-6" id="signalement-informations-bailleur-container">
                {% include 'back/signalement/view/details/informations-bailleur.html.twig' %}
            </div>
        </div>
        <hr class="fr-mt-3w fr-hr">
        <div class="fr-grid-row">
            <div class="fr-col-12 fr-col-md-8">
                <h4 class="fr-h6">Agence et syndic</h4>
            </div>
            <div class="fr-col-12 fr-col-md-4 fr-text--right">
            {# todo : faire fonctionner ce bouton pour masquer la section #}
                {% if is_granted('SIGN_EDIT_ACTIVE', signalement) %}
                    <button class="fr-btn fr-btn--tertiary fr-btn--sm fr-btn--icon-left fr-icon-eye-off-line"
                        data-panel-open="panel-edit-coordonnees-agence"
                        aria-controls="panel-edit-coordonnees-agence"
                        data-fr-opened="false"
                        >Masquer la section</button>
                {% endif %}
            </div>
            <div class="fr-col-12 fr-col-md-6 fr-pr-6v" id="signalement-coordonnees-agence-container">
                {% include 'back/signalement/view/details/coordonnees-agence.html.twig' %}
            </div>

            <div class="fr-col-12 fr-col-md-6" id="signalement-coordonnees-syndic-container">
                {% include 'back/signalement/view/details/coordonnees-syndic.html.twig' %}
            </div>
        </div>
    </div>
{% endif %}
