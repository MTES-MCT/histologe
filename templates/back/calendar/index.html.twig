{% extends 'back/base_bo.html.twig' %}

{% block title %}Calendrier{% endblock %}

{% block content %}
    <section class="fr-pt-5v fr-px-5v">
        {% include 'back/breadcrumb_bo.html.twig' with {
            'level2Title': 'Calendrier',
            'level2Link': '',
            'level2Label': '',
        } %}
    </section>

    <section class="fr-px-5v fr-pb-5v">
        <div id="calendar-app"
            data-ajaxurl="{{ path('back_calendar_events') }}"
            data-operators="{{ operators|json_encode }}"
            data-territories="{{ territories|json_encode }}"
            data-uniquement-mes-dossiers="{{ is_granted('ROLE_ADMIN_TERRITORY') ? '0' : '1' }}"
        ></div>
    </section>
{% endblock %}
