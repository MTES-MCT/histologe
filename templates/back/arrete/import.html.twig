{% extends 'back/base_bo.html.twig' %}

{% block title %}Importer des arrêtés{% endblock %}

{% block content %}
    <section class="fr-pt-4v"
             id="import-arrete-container"
             data-url-confirm-arrete="{{ path('back_arrete_import_confirm') }}"
             data-url-redirection-arrete-list="{{ path('back_territory_management_arrete_index') }}"
    >
        {% include 'back/breadcrumb_bo.html.twig' with {
            'level2Title': 'Outils admin',
            'level2Link': '',
            'level2Label': '',
            'level3Title': 'Mon territoire',
            'level3Link': path('back_territory_management_index'),
            'level4Title': 'Liste des arrêtés importés',
            'level4Link': path('back_territory_management_arrete_index'),
            'level5Title': 'Importer des arrêtés',
            'level5Link': '',
        } %}

        <header>
            <div class="fr-grid-row">
                <div class="fr-col-12">
                    <h1 class="fr-mb-0">Importer des arrêtés</h1>
                </div>
            </div>
        </header>

        <div class="fr-grid-row fr-mt-4w">
            <div class="fr-col-12">
                <p>
                    Vous pouvez importer l'historique des arrêtés pris sur votre territoire à l'aide d'un fichier au
                    format CSV.
                    Une fois importés, vous pourrez consulter les arrêtés sous forme de liste ou de carte dans l'<a
                            href="{{ path('back_addresses_history_index') }}">Historique des adresses</a>.
                </p>

                <div class="fr-callout">
                    <h3 class="fr-callout__title">À lire avant de télécharger votre fichier</h3>
                    <div class="fr-callout__text">
                        <ul>
                            <li>Votre fichier doit être au <strong>format .CSV</strong></li>
                            <li>Votre fichier peut contenir <strong>50 lignes maximum</strong>.
                            </li>
                            <li>Votre fichier doit inclure les <strong>7 colonnes obligatoires</strong> : numéro de voie
                                (avec l'indice de répétition, par exemple « 12bis »), nom de la voie, code postal,
                                commune, classification de l'arrêté, date de l'arrêté et identifiant parcellaire.
                            </li>
                            <li>Votre fichier doit également contenir 2 colonnes facultatives : date de l'arrêté de main
                                levée et le nom du syndicat gestionnaire.
                            </li>
                        </ul>
                        <p class="fr-mt-2w">
                            Pour plus d'informations, veuillez consulter la
                            <a href="https://documentation.signal-logement.beta.gouv.fr/partenaires/responsable-territorial-gerer-mon-territoire/importer-lhistorique-des-arretes-sur-mon-territoire"
                               target="_blank"
                               rel="noreferrer noopener"
                               title="Documentation imports arrêtés - Ouvre une nouvelle fenêtre">documentation en cliquant ici</a>.<br>
                            Pour vous aider, vous pouvez également télécharger le fichier d'exemple en cliquant sur le
                            bouton ci-dessous.
                        </p>
                        <a href="{{ asset('build/files/import_arrete_modele.csv') }}" download
                           class="fr-btn fr-btn--tertiary fr-icon-download-line fr-btn--icon-left">
                            Télécharger le fichier d'exemple
                        </a>

                    </div>
                </div>
                <hr class="fr-mt-4w">

                <div class="fr-mt-4w">
                    <h2>1. Choisir mon fichier</h2>
                    {{ form_start(form, {'action': path('back_arrete_import_upload')}) }}
                    <div class="fr-p-4w import-csv-upload-file">
                        {{ form_row(form.file, {
                            'row_attr': {
                                'class': 'fr-upload-group fr-mb-0'
                            }
                        }) }}
                    </div>
                    {{ form_end(form) }}

                    <div class="fr-mt-2w fr-p-4w import-csv-loading fr-display-none">
                        <span class="fr-icon-time-line fr-text-default--info fr-mb-1v" aria-hidden="true"></span>
                        <p class="fr-text--bold fr-mb-1w">Fichier en cours de téléchargement</p>
                        <p class="fr-mb-0 fr-text--sm">Veuillez patienter jusqu'à la fin du téléchargement de votre
                            fichier.</p>
                    </div>

                    <div class="fr-mt-2w fr-p-4w fr-grid-row fr-grid-row--middle import-csv-success fr-display-none">
                        <div class="fr-col-10">
                            <div class="fr-mb-1w">
                                <span class="fr-icon-check-line fr-text-default--success fr-mb-1v"
                                      aria-hidden="true"></span>
                                <p class="fr-text--bold fr-mb-0">Fichier téléchargé !</p>
                            </div>
                            <p class="fr-mb-0 fr-text--sm">nomdufichier12345.csv</p>
                        </div>
                        <div class="fr-col-2 fr-text--right">
                            <a href="#" class="fr-link fr-icon-close-line fr-link--icon-left">Annuler</a>
                        </div>
                    </div>

                    <div class="fr-callout fr-mt-2w import-csv-error-callout fr-display-none">
                        <h3 class="fr-callout__title">Résumé du téléchargement :</h3>
                        <div class="fr-callout__text">
                            <ul class="fr-mb-0 import-csv-error-list">
                            </ul>
                        </div>
                    </div>

                    <div id="import-csv-data-validation" class="fr-mt-8w import-csv-section--disabled">
                        <h2>2. Vérifier mes données</h2>
                        <p>
                            Pour importer correctement votre historique, nous avons besoin de vérifier que les adresses sont
                            bien enregistrées dans la Base Adresse Nationale (BAN).
                            Veuillez rechercher et sélectionner l'adresse correspondante dans la liste déroulante. Sinon,
                            cocher la case « Ignorer ».
                        </p>

                        <div class="fr-grid-row fr-mt-4w fr-text-mention--grey import-csv-table-header fr-display-md-flex">
                            <div class="fr-col-md-3">ARRÊTÉ CONCERNÉ</div>
                            <div class="fr-col-md-4 fr-pl-md-2w">ADRESSE ACTUELLE</div>
                            <div class="fr-col-md-5 fr-pl-md-2w">SÉLECTIONNER L'ADRESSE DANS LA BAN</div>
                        </div>

                        <div id="import-csv-cards-container"></div>
                        {% include 'back/arrete/_import-csv-card-template.html.twig' %}
                    </div>

                    <hr class="fr-mt-8w">

                    <div id="import-csv-validation" class="fr-mt-4w import-csv-section--disabled">
                        <h2>3. Valider</h2>
                        <p>
                            Vous avez terminé ! Cliquez sur le bouton de validation pour finir votre import.
                            Vous serez redirigé vers l'Historique des adresses où vos arrêtés seront visibles d'ici
                            quelques instants.
                        </p>
                        <div class="fr-mt-4w">
                            <ul class="fr-btns-group fr-btns-group--inline-lg fr-btns-group--center">
                                <li>
                                    <button class="fr-btn fr-btn--secondary" disabled>
                                        Annuler
                                    </button>
                                </li>
                                <li>
                                    <button id="import-csv-validation-submit" class="fr-btn" disabled>
                                        Valider mon import
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
