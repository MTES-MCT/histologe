<h2 class="fr-h4">Description du logement</h2>
{% include 'back/signalement_create/tabs/_partial_facultative.html.twig' %}

{{ form_start(formLogement, {'attr': {'id': 'bo-form-signalement-logement'}}) }}
{{ form_errors(formLogement) }}
<div class="fr-grid-row fr-grid-row--gutters">

    <div class="fr-col-12 fr-col-md-6">
        <fieldset class="fr-fieldset">
            <legend>
                <h3 class="fr-h5">Type de logement</h3>
            </legend>
            {% if signalement.natureLogement == 'appartement' %}
                {% set typeLogementAppartementEtage = '' %}
                {% if signalement.typeCompositionLogement %}
                    {% if signalement.typeCompositionLogement.typeLogementAppartementEtage %}
                        {% set typeLogementAppartementEtage = signalement.typeCompositionLogement.typeLogementAppartementEtage %}
                    {% elseif signalement.typeCompositionLogement.typeLogementRdc is same as 'oui' %}
                        {% set typeLogementAppartementEtage = enum('App\\Entity\\Enum\\EtageType').RDC.value %}
                    {% elseif signalement.typeCompositionLogement.typeLogementDernierEtage is same as 'oui' %}
                        {% set typeLogementAppartementEtage = enum('App\\Entity\\Enum\\EtageType').DERNIER_ETAGE.value %}
                    {% elseif signalement.typeCompositionLogement.typeLogementSousSolSansFenetre is same as 'oui' %}
                        {% set typeLogementAppartementEtage = enum('App\\Entity\\Enum\\EtageType').SOUSSOL.value %}
                    {% endif %}
                {% endif %}
                {% if typeLogementAppartementEtage %}
                    <div class="fr-fieldset__element">
                        <p class="fr-mb-0">
                            Le logement est un appartement situé
                            {% if typeLogementAppartementEtage == enum('App\\Entity\\Enum\\EtageType').RDC.value %}
                                au rez-de-chaussée.
                            {% elseif typeLogementAppartementEtage == enum('App\\Entity\\Enum\\EtageType').DERNIER_ETAGE.value %}
                                au dernier étage.
                            {% elseif typeLogementAppartementEtage == enum('App\\Entity\\Enum\\EtageType').SOUSSOL.value %}
                                au sous-sol.
                            {% else %}
                                à un autre étage{% if signalement.etageOccupant %} ({{ signalement.etageOccupant }}){% endif %}.
                            {% endif %}
                            <span class="fr-hint-text">Modifiable sur l'onglet Adresse.</span>
                        </p>
                    </div>
                {% endif %}
            {% endif %}
            <div class="fr-fieldset__element">
                {{ form_row(formLogement.appartementAvecFenetres) }}
            </div>
            <div class="fr-fieldset__element">
                {{ form_row(formLogement.nombreEtages) }}
            </div>
            <div class="fr-fieldset__element">
                {{ form_row(formLogement.anneeConstruction) }}
            </div>
            <div class="fr-fieldset__element">
                {{ form_row(formLogement.autresOccupantsDesordre) }}
            </div>
        </fieldset>

        <fieldset class="fr-fieldset">
            <legend>
                <h3 class="fr-h5">Organisation du logement</h3>
            </legend>
            <div class="fr-fieldset__element">
                {{ form_row(formLogement.pieceUnique) }}
            </div>
            <div class="fr-fieldset__element">
                {{ form_row(formLogement.nombrePieces) }}
            </div>
            <div class="fr-fieldset__element">
                {{ form_row(formLogement.superficie) }}
            </div>
            <div class="fr-fieldset__element">
                {{ form_row(formLogement.pieceAVivre9m) }}
            </div>
        </fieldset>
    </div>

    <div class="fr-col-12 fr-col-md-6">
        <fieldset class="fr-fieldset">
            <legend>
                <h3 class="fr-h5">Pièces et équipements</h3>
            </legend>
            <div class="fr-fieldset__element">
                {{ form_row(formLogement.cuisine) }}
            </div>
            <div class="fr-fieldset__element">
                {{ form_row(formLogement.sdb) }}
            </div>
            <div class="fr-fieldset__element">
                {{ form_row(formLogement.toilettes) }}
            </div>
            <div class="fr-fieldset__element">
                {{ form_row(formLogement.toilettesCuisineMemePiece) }}
            </div>
            <div class="fr-fieldset__element">
                {{ form_row(formLogement.typeChauffage) }}
            </div>
        </fieldset>
    </div>
</div>
<div class="fr-grid-row form-nav-row-reverse">
    <div class="fr-col-12 fr-col-md-6">
        <div class="fr-grid-row fr-grid-row--right">
            <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-md fr-btns-group--icon-left">
                <li>
                    {{ form_row(formLogement.save) }}
                </li>
                <li>
                    {{ form_row(formLogement.draft) }}
                </li>
                <li>
                    {{ form_row(formLogement.forceSave) }}
                </li>
            </ul>
        </div>
    </div>
    <div class="fr-col-12 fr-col-md-6">
        <div class="fr-grid-row fr-grid-row--left">
            {{ form_row(formLogement.previous) }}
        </div>
    </div>
</div>
{{ form_end(formLogement) }}
