{% extends 'back/base_bo.html.twig' %}

{% block title %}Modifier le bandeau de communication {{inAppCommunication.title}}{% endblock %}

{% block content %}
    <section class="fr-pt-4v">
        {% include 'back/breadcrumb_bo.html.twig' with {
            'level2Title': 'Outils SA',
            'level2Link': '',
            'level2Label': '',
            'level3Title': 'Bandeaux de communication',
            'level3Link': path('back_config_in_app_communication_index'),
            'level4Title': 'Modifier le bandeau de communication '~ inAppCommunication.id,
            'level4Link': '',
        } %}
        <header>
            <div class="fr-grid-row">
                <div class="fr-col-12 fr-text--left">
                    <h1 class="fr-mb-0">Bandeau de communication {{inAppCommunication.id}}</h1>
                    <span>Remplissez le formulaire ci-dessous pour modifier le bandeau de communication.</span><br>
                </div>
            </div>
        </header>
    </section>

    <section class="fr-grid-row fr-pt-4v">        
        <div class="fr-col-12">
            {{ form_start(form, {'attr': {'id': 'form-add-zone'}}) }}
            {{ form_errors(form) }}
            <div class="fr-grid-row fr-grid-row--gutters">
                <div class="fr-col-12">
                    {{ form_row(form.title) }}
                </div>
                <div class="fr-col-12">
                    {{ form_row(form.description) }}
                </div>
                <div class="fr-col-12">
                    {{ form_row(form.url) }}
                </div>
                <div class="fr-col-12">
                    {{ form_row(form.urlTitle) }}
                </div>
                <div class="fr-col-12">
                    {{ form_row(form.userRoles) }}
                </div>
                <div class="fr-col-12">
                    {{ form_row(form.communicationType) }}
                </div>
                <div class="fr-col-12">
                    <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline fr-btns-group--icon-left">
                        <li>
                            {{ form_row(form.submit) }}
                        </li>
                        <li>
                            <a href="{{path('back_config_in_app_communication_index')}}" class="fr-btn fr-btn--secondary fr-btn--icon-left fr-icon-close-line" type="button">Annuler</a>
                        </li>
                    </ul>
                </div>
            </div>
            {{ form_end(form) }}
        </div>
    </section>

{% endblock %}
