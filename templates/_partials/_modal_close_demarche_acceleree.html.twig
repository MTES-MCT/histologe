<dialog aria-labelledby="close-demarche-acceleree-modal-title" id="close-demarche-acceleree-modal" class="fr-modal">
    <div class="fr-container fr-container--fluid fr-container-md">
        <div class="fr-grid-row fr-grid-row--center">
            <div class="fr-col-12 fr-col-md-10 fr-col-lg-8">
                <div class="fr-modal__body">
                    <div class="fr-modal__header">
                        <button type="button" class="fr-btn--close fr-btn" aria-controls="close-demarche-acceleree-modal">Fermer</button>
                    </div>
                    <div class="fr-modal__content">
                        {{ form_start(adminCancelInjonctionProcedureForm, {'attr': {'id': 'form-admin-cancel-procedure', 'data-submit-type': 'formData'}}) }}
                        {{ form_errors(adminCancelInjonctionProcedureForm) }}
                            <h1 class="title-blue-france">Fermer la démarche accélérée #{{ signalement.reference }}</h1>
                            <div class="fr-my-3w">
                                <div class="fr-mb-2w">
                                    Expliquez pourquoi vous souhaitez arrêter la procédure.<br>
                                    Tous les champs sont obligatoires.
                                </div>
                                
                                <div class="fr-mb-2w">
                                    {{ form_widget(adminCancelInjonctionProcedureForm.reason, {display_mode: 'block-borders'}) }}
                                </div>

                                {{ form_row(adminCancelInjonctionProcedureForm.details,{}) }}
                            </div>	
                        {{ form_end(adminCancelInjonctionProcedureForm) }}
                    </div>
                    <div class="fr-modal__footer">
                        <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-lg fr-btns-group--icon-left">
                            <li>
                                <button class="fr-btn fr-w-100 fr-icon-check-line" form="form-admin-cancel-procedure" type="submit">      
                                    Fermer le signalement
                                </button>
                            </li>
                            <li>
                                <button class="fr-btn fr-btn--secondary fr-icon-close-line"
                                        aria-controls="close-demarche-acceleree-modal" type="button">
                                    Annuler
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</dialog>