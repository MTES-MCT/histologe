{% if qualification.qualification.label is same as 'Suspicion Danger occupant'
    or qualification.qualification.label is same as 'Mise en sécurité/Péril'
    or qualification.qualification.label is same as 'Suspicion Insalubrité'
    or qualification.qualification.label is same as 'Insalubrité'
    or qualification.qualification.label is same as 'Suspicion Non décence'
    or qualification.qualification.label is same as 'Suspicion Mise en sécurité/Péril'
    or qualification.qualification.label is same as 'Suspicion Suroccupation'
    or qualification.qualification.label is same as 'Suspicion Assurantiel'
    or qualification.qualification.label is same as 'Suspicion Manquement à la salubrité'
    or qualification.qualification.label is same as 'Suspicion Non décence/RSD'
    or qualification.qualification.label is same as 'Suspicion RSD'
    or qualification.qualification.label is same as 'Non décence énergétique à vérifier'
    or qualification.qualification.label is same as 'Non décence énergétique avérée'
    or qualification.qualification.label is same as 'Non décence'
    or qualification.qualification.label is same as 'RSD'
    or qualification.qualification.label is same as 'Suspicion Saleté'
    or qualification.qualification.label is same as 'Saleté' %}

    {% set typeBadge = 'info' %}
    {% if qualification.qualification.label is same as 'Suspicion Danger occupant'
        or qualification.qualification.label is same as 'Mise en sécurité/Péril' 
        or qualification.qualification.label is same as 'Suspicion Mise en sécurité/Péril' %}
        {% set typeBadge = 'error' %}
    {% elseif qualification.qualification.label is same as 'Suspicion Insalubrité'
        or qualification.qualification.label is same as 'Insalubrité'
        or qualification.qualification.label is same as 'Suspicion Manquement à la salubrité' %}
        {% set typeBadge = 'warning' %}
    {% endif %}

    <small class="fr-badge fr-badge--{{ typeBadge }} fr-badge--no-icon fr-mb-1v">{{ qualification.qualification.label|replace({'Suspicion ': '', ' à vérifier': '', ' avérée': ''}) }}</small>
{% endif %}