<dialog aria-labelledby="panel-affectation-title" id="panel-affectation" class="side-panel" data-panel-reset-form>
    <div class="side-panel__inner">
        <div class="side-panel__header">
            <button type="button" class="fr-btn--close fr-btn js-close-panel" data-panel="panel-affectation" aria-controls="panel-affectation" aria-expanded="false">Fermer</button>
        </div>
        <div class="side-panel__content fr-mx-3w">
            <h1 id="panel-affectation-title" class="fr-modal__title title-blue-france">Affecter le dossier</h1>
            <p>Gérer les partenaires affectés au dossier</p>
            <div id="signalement-affectation-form-row">
                {% include '_partials/signalement/_affectation_selects.html.twig' %}
            </div>
        </div>
        <div class="side-panel__footer">
            <ul class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-lg fr-btns-group--icon-left">
                <li>
                    <button class="fr-btn fr-icon-check-line" type="submit" form="signalement-affectation-form">
                        Valider les affectations
                    </button>
                </li>
                <li>
                    <button class="fr-btn fr-btn--secondary fr-icon-close-line js-close-panel" data-panel="panel-affectation" aria-controls="panel-affectation" type="button">
                        Annuler
                    </button>
                </li>
            </ul>
        </div>
    </div>
</dialog>
