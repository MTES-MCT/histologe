{% if signalement.typeCompositionLogement %}
    {% set EtageType = enum('\\App\\Entity\\Enum\\EtageType') %}
    {% set etage = null %}
    {% if signalement.typeCompositionLogement.typeLogementAppartementEtage %}
        {% set etage = signalement.typeCompositionLogement.typeLogementAppartementEtage %}
    {% elseif signalement.typeCompositionLogement.typeLogementRdc == 'oui' %}
        {% set etage = EtageType.RDC.value %}
    {% elseif signalement.typeCompositionLogement.typeLogementDernierEtage == 'oui' %}
        {% set etage = EtageType.DERNIER_ETAGE.value %}
    {% elseif signalement.typeCompositionLogement.typeLogementSousSolSansFenetre == 'oui' %}
        {% set etage = EtageType.SOUSSOL.value %}
    {% elseif signalement.natureLogement == 'appartement' %}
        {% set etage = EtageType.AUTRE.value %}
    {% endif %}

    {% if etage %}
        {% if etage == EtageType.AUTRE.value and signalement.etageOccupant %}
            {{ EtageType.from(etage).label }} ({{ signalement.etageOccupant }})
        {% else %}
            {{ EtageType.from(etage).label }}
        {% endif %}
    {% endif %}
{% endif %}
