includes:
	- phpstan.neon

parameters:
	# On réactive la détection de code mort (désactivée dans phpstan.neon)
	shipmonkDeadCode:
		detect:
			deadMethods: true
			deadConstants: true
			deadEnumCases: true
			deadProperties:
				neverRead: true
				neverWritten: true
		# Un membre utilisé uniquement depuis les tests sera tout de même signalé
		usageExcluders:
			tests:
				enabled: true
	ignoreErrors:
		-
			# Esabora : propriétés inutilisés (présente pour cohérence avec le contrat d'interface)
			message: '#^Unused .*::#'
			path: src/Service/Interconnection/Esabora/Response/*
		-
			# Esabora : propriétés inutilisés (faut-il garder ?)
			message: '#^Unused .*::#'
			path: src/Messenger/Message/Esabora/DossierMessageSISH.php
		-
			# Esabora : cascade de l'exclusion précédente sur DossierMessageSISH
			message: '#^Unused .*::#'
			path: src/Entity/Enum/SISHDossierType.php
		-
			# Esabora : propriétés écrites mais jamais lues (faut-il garder ?)
			message: '#^Property .*AbstractDossierSISHHandler::\$.* is never read#'
			path: src/Service/Interconnection/Esabora/Handler/AbstractDossierSISHHandler.php
		-
			# OAuth2Token : propriétés du contrat API non consommées
			message: '#^Property .*OAuth2TokenResponse::\$.* is never read#'
			path: src/Service/Gouv/ProConnect/Response/OAuth2TokenResponse.php
		-
			# Faux positif : interface avec #[AutoconfigureTag] appelée dynamiquement par le conteneur Symfony
			message: '#^Unused .*::#'
			path: src/Service/Interconnection/Esabora/Handler/InterventionSISHHandlerInterface.php
		-
			# Faux positif : DTO sérialisés (API JSON) ou passés aux templates Twig
			message: '#^(Unused|Thus|Property) .*#'
			path: src/Dto/*
		-
			# Faux positif : DTO sérialisé en JSON (getter appelé dynamiquement par le Serializer)
			message: '#^Unused .*::#'
			path: src/Service/Import/Arrete/ArreteImportRow.php
		-
			# Faux positif : DTO passé aux templates Twig (propriétés publiques lues dynamiquement)
			message: '#^(Unused|Thus|Property) .*#'
			path: src/Service/DashboardTabPanel/TabDossier.php
		-
			# Faux positif : appelée dynamiquement par #[MapEntity] dans les contrôleurs
			message: '#^Unused .*::findOneByCodeAndToken#'
			path: src/Repository/TiersInvitationRepository.php
		-
			# Faux positif : event listener enregistré via services.yaml (kernel.event_listener)
			message: '#^(Unused|Thus) .*AuthentificationSuccessListener::#'
			path: src/EventListener/AuthentificationSuccessListener.php
		-
			# Faux positif : getters/setters d'entités Doctrine — utilisés dynamiquement par Doctrine, Twig, formulaires, etc. (certain cas réel seront donc ignoré)
			message: '#^Unused App\\Entity\\.*::(get|set|is|has).*#'
			path: src/Entity/*
		-
			# Faux positif : types DBAL Doctrine custom — méthodes appelées dynamiquement par Doctrine
			message: '#^Unused .*Type::#'
			path: src/Entity/DoctrineType/*
		-
			# Faux positif : méthodes show() appelées dynamiquement depuis Twig via render(controller(...))
			message: '#^Unused App\\Controller\\Back\\(InAppCommunicationController|PopNotificationController)::show#'
			path: src/Controller/Back/*
